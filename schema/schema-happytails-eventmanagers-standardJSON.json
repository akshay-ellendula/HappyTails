{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "__v",
    "bio",
    "company_name",
    "contact_number",
    "created_at",
    "email",
    "event_type",
    "image",
    "license",
    "location",
    "member_since",
    "name",
    "password"
  ],
  "properties": {
    "_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "__v": {
      "type": "integer"
    },
    "bio": {
      "type": [
        "string",
        "null"
      ]
    },
    "company_name": {
      "type": "string"
    },
    "contact_number": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/Date"
    },
    "email": {
      "type": "string"
    },
    "event_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": "string"
    },
    "member_since": {
      "type": "null"
    },
    "name": {
      "type": "string"
    },
    "password": {
      "type": "string"
    }
  },
  "$defs": {
    "ObjectId": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "Date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  }
}