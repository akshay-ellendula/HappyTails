<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events</title>
    <link rel="stylesheet" href="/Events/events.css" />
</head>
<body>
    <div class="navbar">
      <header>
          <a href="/home" class="badge">Happy Tails</a>
          <div class="menu">
              <a href="/services">Services</a>
              <a href="/pet_adoption">Shop</a>
              <a href="/blog">Blog</a>
              <a href="/pet_accessory">Pet Essentials</a>
              <% if (user) { %>
                <a href="/profile">Profile</a>
              <% } else { %>
                  <a href="/my_login">Login/SignUp</a>
              <% } %>
          </div>
          <div class="menu-icon" id="menuIcon">
            <img src="/icons/hamburger-svgrepo-com.svg" alt="Menu" height="25px" />
          </div>
          <div class="side-navbar" id="sideNavbar">
            <a href="javascript:void(0)" class="close-btn" id="closeBtn">&times;</a>
            <a href="/pet_adoption">Shop</a>
            <a href="/pet_accessory">Pet Essentials</a>        
            <a href="/services">Services</a>
            <a href="/blog">Blog</a>
            <% if (user) { %>
              <a href="/profile">Profile</a>
            <% } else { %>
                <a href="/my_login">Login/SignUp</a>
            <% } %>
          </div>
      </header>
    </div>

    <div class="heading">
        <h2>Upcoming Events</h2>
        <hr>
        <select name="city" id="city">
            <option value="none">select city</option>
            <option value="Hyderabad">Hyderabad</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Chennai">Chennai</option>
            <option value="Bengaluru">Bengaluru</option>
            <option value="Delhi">Delhi</option>
        </select>
    </div>


    <div class="events_container">
        <div class="event_card">
            <div class="image_container">
                <img src="/images/event_poster1.jpg" alt="event_image">
            </div>
            <div class="details_container">
                <h3>Pet-Friendly Café</h3>
                <p class="description">Join us for a lively and friendly pet-friendly café at our home in the heart of town.</p>
                <p><span>Date:</span> 12th June 2021</p>
                <p><span>Time:</span> 10:00 AM</p>
                <p><span>Location:</span> Pullman,Aerocity</p>
                <p><span>Contact:</span> <a href="tel:contact">123456789</a></p>
                <button type="button" class="book_btn" onclick="window.location.href='/event_booking' ">Book Now</button>
            </div>
        </div>

        <div class="event_card">
            <div class="image_container">
                <img src="/images/event_poster2.jpg" alt="event_image">
            </div>
            <div class="details_container">
                <h3>Pet-Friendly Café</h3>
                <p class="description">Join us for a lively and friendly pet-friendly café at our home in the heart of town.</p>
                <p><span>Date:</span> 12th June 2021</p>
                <p><span>Time:</span> 10:00 AM</p>
                <p><span>Location:</span> Pullman,Aerocity</p>
                <p><span>Contact:</span> <a href="tel:contact">123456789</a></p>
                <button type="button" class="book_btn" onclick="window.location.href='/event_booking'">Book Now</button>
            </div>
        </div>


        <div class="event_card">
            <div class="image_container">
                <img src="/images/event_poster1.jpg" alt="event_image">
            </div>
            <div class="details_container">
                <h3>Pet-Friendly Café</h3>
                <p class="description">Join us for a lively and friendly pet-friendly café at our home in the heart of town.</p>
                <p><span>Date:</span> 12th June 2021</p>
                <p><span>Time:</span> 10:00 AM</p>
                <p><span>Location:</span> Pullman,Aerocity</p>
                <p><span>Contact:</span> <a href="tel:contact">123456789</a></p>
                <button type="button" class="book_btn" onclick="window.location.href='/event_booking'">Book Now</button>
            </div>
        </div>
    </div>

   <!-- gfhdbj -->



    <footer class="footer">
        <div class="footer-container">
          
          <div class="footer-column">
            <h3>Happy Tails</h3>
            <ul>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/pet_adoption">Pet Stores</a></li>
              <li><a href="/pet_accessory">Online Pet Accessories</a></li>
            </ul>
          </div>
          
          
          <div class="footer-column">
            <h3>Services</h3>
            <ul>
              <li><a href="/services">Pet Grooming</a></li>
              <li><a href="/services">Dog Training</a></li>
              <li><a href="/services">Vet Consultation</a></li>
            </ul>
          </div>
          
  
          <div class="footer-column">
            <h3>Partner</h3>
            <ul>
              <li><a href="/service_login">Become a Groomer</a></li>
              <li><a href="/service_login">Become a Dog Trainer</a></li>
              <li><a href="/service_login">Become Vet partner</a></li>
              <li><a href="#">Pet Store Franchise</a></li>
            </ul>
          </div>
          
          <div class="footer-column">
            <h3>Policy</h3>
            <ul>
              <li><a href="#">Privacy Policy</a></li>
              <li><a href="#">Refund Policy</a></li>
              <li><a href="#">Cancellation Policy</a></li>
              <li><a href="#">Terms & Conditions</a></li>
            </ul>
            <div class="footer-social">
              <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="Facebook"></a>
              <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="Instagram"></a>
              <a href="#"><img src="/icons/youtube-icon-logo-svgrepo-com.svg" alt="YouTube"></a>
            </div>
          </div>
        </div>
    </footer>


    <script>
      document.getElementById('menuIcon').addEventListener('click', function() {
          document.getElementById('sideNavbar').classList.toggle('open');
      });

      document.getElementById('closeBtn').addEventListener('click', function() {
          document.getElementById('sideNavbar').classList.remove('open');
      });
    </script>
</body>
</html>