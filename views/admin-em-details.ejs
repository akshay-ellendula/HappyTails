<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Tails - Event Manager Details</title>
    <link href="/ADMIN/admin-em-details.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="header">
            <button class="back-button" onclick="goBack()">← Back to Managers</button>
            <div class="action-buttons">
                <button class="edit-btn" onclick="showEditForm()">Edit Manager</button>
                <button class="delete-btn" onclick="deleteManager()">Delete Manager</button>
            </div>
        </div>

        <div id="managerView">
            <div class="manager-profile">
                <div class="manager-avatar" id="managerAvatar">M</div>
                <h2 class="manager-name" id="managerName">Michael Parker</h2>
                <p class="manager-email" id="managerEmail">michael.parker@happytails.com</p>
                <div style="clear: both;"></div>
            </div>

            <div class="detail-section">
                <h3 class="section-title">Basic Information</h3>
                <table class="details-table">
                    <tr>
                        <td>Manager ID:</td>
                        <td id="managerId">#EMG003</td>
                    </tr>
                    <tr>
                        <td>Joined Date:</td>
                        <td id="joinedDate">Dec 12, 2024</td>
                    </tr>
                    <tr>
                        <td>Department:</td>
                        <td id="department">Event Planning</td>
                    </tr>
                    <tr>
                        <td>Contact:</td>
                        <td id="managerPhone">(555) 345-6789</td>
                    </tr>
                </table>
            </div>

            <div class="detail-section">
                <h3 class="section-title">Event Performance Metrics</h3>
                <div class="revenue-cards">
                    <div class="revenue-card">
                        <div class="revenue-value">12</div>
                        <div class="revenue-label">Upcoming Events</div>
                    </div>
                    <div class="revenue-card">
                        <div class="revenue-value">5</div>
                        <div class="revenue-label">This Week's Events</div>
                    </div>
                    <div class="revenue-card">
                        <div class="revenue-value">18</div>
                        <div class="revenue-label">Monthly Events</div>
                    </div>
                    <div class="revenue-card">
                        <div class="revenue-value">98%</div>
                        <div class="revenue-label">Avg. Satisfaction Rate</div>
                    </div>
                </div>

                <table class="revenue-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Total Events</th>
                            <th>Attendees</th>
                            <th>Avg Attendance</th>
                            <th>Growth</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>March 2025</td>
                            <td>18</td>
                            <td>523</td>
                            <td>29.1</td>
                            <td>+6.2%</td>
                        </tr>
                        <tr>
                            <td>February 2025</td>
                            <td>15</td>
                            <td>438</td>
                            <td>29.2</td>
                            <td>+3.8%</td>
                        </tr>
                        <tr>
                            <td>January 2025</td>
                            <td>14</td>
                            <td>405</td>
                            <td>28.9</td>
                            <td>+2.5%</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="detail-section">
                <h3 class="section-title">Upcoming Events</h3>
                <table class="events-table">
                    <thead>
                        <tr>
                            <th>Event ID</th>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Capacity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>EVT102</td>
                            <td>Pet Adoption Day</td>
                            <td>Mar 22, 2025</td>
                            <td>Central Park</td>
                            <td>150/200</td>
                            <td><span class="status-active">Registering</span></td>
                        </tr>
                        <tr>
                            <td>EVT104</td>
                            <td>Dog Training Workshop</td>
                            <td>Mar 25, 2025</td>
                            <td>Happy Tails HQ</td>
                            <td>45/50</td>
                            <td><span class="status-active">Almost Full</span></td>
                        </tr>
                        <tr>
                            <td>EVT106</td>
                            <td>Pet Health Seminar</td>
                            <td>Mar 29, 2025</td>
                            <td>Community Center</td>
                            <td>80/120</td>
                            <td><span class="status-active">Registering</span></td>
                        </tr>
                        <tr>
                            <td>EVT108</td>
                            <td>Cat Show Competition</td>
                            <td>Apr 5, 2025</td>
                            <td>Exhibition Hall</td>
                            <td>50/100</td>
                            <td><span class="status-active">Early Bird</span></td>
                        </tr>
                        <tr>
                            <td>EVT110</td>
                            <td>Pet Photography Session</td>
                            <td>Apr 12, 2025</td>
                            <td>Riverside Park</td>
                            <td>15/20</td>
                            <td><span class="status-active">Almost Full</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="detail-section">
                <h3 class="section-title">Past Events</h3>
                <table class="past-events-table">
                    <thead>
                        <tr>
                            <th>Event ID</th>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Attendees</th>
                            <th>Satisfaction</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>EVT095</td>
                            <td>Puppy Socialization Day</td>
                            <td>Mar 15, 2025</td>
                            <td>42/50</td>
                            <td>96%</td>
                        </tr>
                        <tr>
                            <td>EVT093</td>
                            <td>Pet Nutrition Workshop</td>
                            <td>Mar 8, 2025</td>
                            <td>36/40</td>
                            <td>98%</td>
                        </tr>
                        <tr>
                            <td>EVT091</td>
                            <td>Adoption Drive</td>
                            <td>Mar 1, 2025</td>
                            <td>185/200</td>
                            <td>99%</td>
                        </tr>
                        <tr>
                            <td>EVT089</td>
                            <td>Veterinary Q&A Session</td>
                            <td>Feb 22, 2025</td>
                            <td>78/80</td>
                            <td>97%</td>
                        </tr>
                        <tr>
                            <td>EVT087</td>
                            <td>Pet First Aid Course</td>
                            <td>Feb 15, 2025</td>
                            <td>30/30</td>
                            <td>100%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit Form -->
        <div id="editForm" class="edit-form">
            <div class="detail-section">
                <h3 class="section-title">Edit Manager Information</h3>
                <form id="managerEditForm">
                    <div class="form-group">
                        <label for="editName">Name:</label>
                        <input type="text" id="editName" value="Michael Parker">
                    </div>
                    <div class="form-group">
                        <label for="editEmail">Email:</label>
                        <input type="email" id="editEmail" value="michael.parker@happytails.com">
                    </div>
                    <div class="form-group">
                        <label for="editDepartment">Department:</label>
                        <input type="text" id="editDepartment" value="Event Planning">
                    </div>
                    <div class="form-group">
                        <label for="editPhone">Phone:</label>
                        <input type="text" id="editPhone" value="(555) 345-6789">
                    </div>
                    <div class="form-group">
                        <label for="editStatus">Status:</label>
                        <select id="editStatus">
                            <option value="Active" selected>Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="On Leave">On Leave</option>
                        </select>
                    </div>
                    <button type="button" class="save-btn" onclick="saveManagerChanges()">Save Changes</button>
                    <button type="button" class="cancel-btn" onclick="cancelEdit()">Cancel</button>
                </form>
            </div>
        </div>
    </div>

    <script src="/ADMIN/admin-em-details.js"></script>
</body>
</html>