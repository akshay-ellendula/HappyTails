<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Tails - Event Management</title>
    <link href="/ADMIN/admin-events.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1>Happy Tails</h1>
            </div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/admin-dashboard" class="nav-link">
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin-user" class="nav-link">
                        <span>Users</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin-shop-manager" class="nav-link">
                        <span>Shop Managers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin-eventManager" class="nav-link">
                        <span>Event Managers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin-events" class="nav-link active">
                        <span>Events</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin-products" class="nav-link">
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/admin/logout" class="nav-link">
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-content">
            <div class="header">
                <h2>Event Management</h2>
                <div class="user-info">
                    <div class="avatar">A</div>
                    <span>Admin User</span>
                </div>
            </div>

            <div class="stats-container">
                <div class="stat-card">
                    <h3>Total Events</h3>
                    <div class="number" id="totalEvents">--</div>
                </div>
                <div class="stat-card">
                    <h3>Upcoming Events</h3>
                    <div class="number" id="upcomingEvents">--</div>
                </div>
                <div class="stat-card">
                    <h3>Completed Events</h3>
                    <div class="number" id="completedEvents">--</div>
                </div>
                <div class="stat-card">
                    <h3>Total Tickets Sold</h3>
                    <div class="number" id="ticketsSold">--</div>
                </div>
            </div>

            <div class="search-container">
                <div class="search-bar">
                    <input type="text" id="eventSearchInput" placeholder="Search events by name or manager...">
                </div>
                <button class="filter-btn" id="filterBtn">Filter Options</button>
            </div>

            <div class="manager-table-container">
                <div class="table-header">
                    <h3>Event List</h3>
                </div>
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Manager</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="eventTableBody">
                        </tbody>
                </table>
                
                <div class="pagination">
                    <button class="page-btn active">1</button>
                    <button class="page-btn">2</button>
                    <button class="page-btn">3</button>
                    <button class="page-btn">Next</button>
                </div>
            </div>
        </main>
    </div>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        
        let allEvents = []; // This will hold the master list of events

        // --- UI Update Functions (Unchanged) ---
        function updateStatCards(stats) {
            document.getElementById('totalEvents').textContent = stats.totalEvents ?? '0';
            document.getElementById('upcomingEvents').textContent = stats.upcomingEvents ?? '0';
            document.getElementById('completedEvents').textContent = stats.completedEvents ?? '0';
            document.getElementById('ticketsSold').textContent = stats.ticketsSold ?? '0';
        }

        function populateEventTable(events) {
            const tableBody = document.getElementById('eventTableBody');
            tableBody.innerHTML = ''; 

            if (!events || events.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No events found.</td></tr>';
                return;
            }

            let rowsHtml = '';
            events.forEach(event => {
                rowsHtml += `
                    <tr>
                        <td>${event.event_name}</td>
                        <td>${event.event_manager_id?.name || 'N/A'}</td>
                        <td>${new Date(event.date_time).toLocaleDateString()}</td>
                        <td>${event.city}</td>
                        <td><span class="status ${event.status?.toLowerCase() || ''}">${event.status}</span></td>
                        <td>
                            <button class="action-btn delete" data-id="${event._id}">Delete</button>
                        </td>
                    </tr>
                `;
            });
            tableBody.innerHTML = rowsHtml;
        }

        // --- Data Fetching and Filtering (Unchanged) ---
        async function loadEventData() {
            try {
                const response = await fetch('/admin/events');
                if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
                
                const result = await response.json();
                if (result.success) {
                    allEvents = result.data.events;
                    console.log(allEvents)
                    updateStatCards(result.data.stats);
                    populateEventTable(allEvents); 
                } else {
                    throw new Error(result.message || 'Failed to fetch data.');
                }
            } catch (error) {
                console.error('Could not fetch event data:', error);
                document.getElementById('eventTableBody').innerHTML = '<tr><td colspan="6" style="text-align:center; color:red;">Failed to load data.</td></tr>';
            }
        }
        
        function handleSearch() {
            const searchTerm = document.getElementById('eventSearchInput').value.toLowerCase().trim();
            const filteredEvents = allEvents.filter(event => 
                event.event_name.toLowerCase().includes(searchTerm) || 
                (event.event_manager_id?.name || '').toLowerCase().includes(searchTerm)
            );
            populateEventTable(filteredEvents);
        }

        // --- NEW: Function to handle Delete Button Clicks ---
        async function handleDeleteClick(eventId) {
            // 1. Confirm with the user before deleting
            if (!confirm('Are you sure you want to delete this event?\nThis action cannot be undone.')) {
                return; // Stop if the user clicks "Cancel"
            }

            try {
                // 2. Send the DELETE request to the API
                const response = await fetch(`/admin/events/${eventId}`, {
                    method: 'DELETE',
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert(result.message); // Show success message
                    
                    // 3. Update the UI instantly without a page reload
                    // Remove the event from our master list
                    allEvents = allEvents.filter(event => event._id !== eventId);
                    // Re-run the search/filter to update the currently displayed table
                    handleSearch();

                } else {
                    // Show an error message from the server if something went wrong
                    throw new Error(result.message || 'Failed to delete event.');
                }

            } catch (error) {
                console.error('Error during event deletion:', error);
                alert(`Error: ${error.message}`);
            }
        }


        // --- Event Listeners ---
        
        // Listener for the search input
        document.getElementById('eventSearchInput').addEventListener('input', handleSearch);

        // --- MODIFIED: Event Delegation for Action Buttons ---
        // Add one listener to the table body to handle all clicks inside it
        document.getElementById('eventTableBody').addEventListener('click', (e) => {
            // Check if a delete button was clicked
            if (e.target && e.target.classList.contains('delete')) {
                const eventId = e.target.dataset.id; // Get the ID from the data-id attribute
                if (eventId) {
                    handleDeleteClick(eventId);
                }
            }
            // You can add a similar check for the 'view' button here
            if (e.target && e.target.classList.contains('view')) {
                alert(`View button clicked for event ID: ${e.target.dataset.id}`);
            }
        });

        // --- Initial Load ---
        loadEventData();
    });
</script>
</body>
</html>