<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details - Admin Dashboard</title>
    <link href="/ADMIN/admin-product-details.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="header">
            <button class="back-button" onclick="goBack()">← Back to Products</button>
            <div class="action-buttons">
                <button class="edit-btn" onclick="showEditForm()">Edit Product</button>
                <button class="delete-btn" onclick="deleteProduct()">Delete Product</button>
            </div>
        </div>

        <% if (product) { %>
            <div id="productView">
                <div class="product-profile">
                    <div class="product-image">
                        <img id="productImage" src="data:image/jpeg;base64,<%= product.image %>" alt="Product Image">
                    </div>
                    <div class="product-info">
                        <h2 class="product-name" id="productName"><%= product.product_name %></h2>
                        <p class="product-category" id="productCategory"><%= product.product_category %></p>
                        <div>
                            <span class="product-price" id="productPrice">$<%= product.regular_price.toFixed(2) %></span>
                        </div>
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="section-title">Product Information</h3>
                    <table class="details-table">
                        <tr>
                            <td>Product ID:</td>
                            <td id="productId"><%= product.id %></td>
                        </tr>
                        <tr>
                            <td>SKU:</td>
                            <td id="productSku"><%= product.sku || 'N/A' %></td>
                        </tr>
                        <tr>
                            <td>Date Added:</td>
                            <td id="dateAdded"><%= new Date(product.created_at).toLocaleDateString() %></td>
                        </tr>
                        <tr>
                            <td>Shop Owner:</td>
                            <td id="shopOwner"><%= product.vendor.store_name %></td>
                        </tr>
                        <tr>
                            <td>Vendor Email:</td>
                            <td id="vendorEmail"><%= product.vendor.email %></td>
                        </tr>
                        <tr>
                            <td>Current Stock:</td>
                            <td id="currentStock"><%= product.stock_quantity %></td>
                        </tr>
                    </table>
                </div>

                <div class="detail-section">
                    <h3 class="section-title">Product Description</h3>
                    <p id="productDescription"><%= product.product_description %></p>
                </div>
                
                <div class="detail-section">
                    <h3 class="section-title">Purchased By</h3>
                    <table class="details-table">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>Order Date</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (customers && customers.length > 0) { %>
                                <% customers.forEach(customer => { %>
                                    <tr>
                                        <td><%= customer.user_name %></td>
                                        <td><%= customer.user_email %></td>
                                        <td><%= new Date(customer.order_date).toLocaleDateString() %></td>
                                        <td><%= customer.quantity %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4">No purchase history found for this product.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } else { %>
            <div class="detail-section">
                <h3 class="section-title">Product not found.</h3>
                <p>The product you are looking for does not exist or an error occurred.</p>
                <button class="back-button" onclick="goBack()">← Back to Products</button>
            </div>
        <% } %>

        <div id="editForm" class="edit-form detail-section">
            <h3 class="section-title">Edit Product</h3>
            <form id="productEditForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="edit-name">Product Name</label>
                        <input type="text" id="edit-name" value="">
                    </div>
                    <div class="form-group">
                        <label for="edit-category">Category</label>
                        <input type="text" id="edit-category" value="">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="edit-price">Price ($)</label>
                        <input type="number" id="edit-price" value="" step="0.01">
                    </div>
                    <div class="form-group">
                        <label for="edit-stock">Current Stock</label>
                        <input type="number" id="edit-stock" value="">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="edit-sku">SKU</label>
                        <input type="text" id="edit-sku" value="">
                    </div>
                    <div class="form-group">
                        <label for="edit-brand">Brand</label>
                        <input type="text" id="edit-brand" value="">
                    </div>
                </div>
                <div class="form-group">
                    <label for="edit-description">Description</label>
                    <textarea id="edit-description"></textarea>
                </div>
                <div>
                    <button type="button" class="save-btn" onclick="saveProductChanges()">Save Changes</button>
                    <button type="button" class="cancel-btn" onclick="hideEditForm()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    <script src="/ADMIN/admin-product-details.js"></script>
</body>
</html>