<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="/ADMIN/admin-user-details.css"> <!-- Adjust path as needed -->
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/admin-user" class="back-button">← Back to Users</a>
            <div class="action-buttons">
                <button id="edit-user-btn" class="edit-btn">Edit User</button>
                <button id="delete-user-btn" class="delete-btn">Delete User</button>
            </div>
        </div>

        <div class="user-profile" id="userView">
    <div class="user-avatar" id="userAvatar"></div> <!-- Container for avatar -->
    <div class="details">
        <h2>Basic Information</h2>
        <table class="details-table">
            <tr><td>Name:</td><td><span id="userName"></span></td></tr>
            <tr><td>User ID:</td><td><span id="userId"></span></td></tr>
            <tr><td>Joined Date:</td><td><span id="joinedDate"></span></td></tr>
            <tr><td>Address:</td><td><span id="userAddress"></span></td></tr>
            <tr><td>Phone:</td><td><span id="userPhone"></span></td></tr>
        </table>
    </div>
</div>

        <div class="detail-section">
            <h2 class="section-title">Shop Purchase History</h2>
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Product ID</th>
                        <th>Product Name</th>
                        <th>Purchase Date</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody id="purchaseHistoryTable">
                    <tr><td colspan="4">Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="detail-section">
            <h2 class="section-title">Event Participation</h2>
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Event ID</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="eventHistoryTable">
                    <tr><td colspan="5">Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="edit-form" id="editForm" style="display: none;">
            <h2 class="section-title">Edit User Information</h2>
            <form id="userEditForm">
                <div class="form-group">
                    <label>Name:</label>
                    <input type="text" id="editName">
                    <span id="nameError" class="error-message"></span>
                </div>
                <div class="form-group">
                    <label>Email:</label>
                    <input type="email" id="editEmail">
                    <span id="emailError" class="error-message"></span>
                </div>
                <div class="form-group">
                    <label>Address:</label>
                    <input type="text" id="editAddress">
                    <span id="addressError" class="error-message"></span>
                </div>
                <div class="form-group">
                    <label>Phone:</label>
                    <input type="text" id="editPhone">
                    <span id="phoneError" class="error-message"></span>
                </div>
                <button type="submit" class="save-btn">Save Changes</button>
                <button type="button" id="cancel-edit" class="cancel-btn">Cancel</button>
            </form>
        </div>
    </div>

    <script src="/ADMIN/admin-user-details.js"></script> <!-- Adjust path as needed -->
</body>
</html>