<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.event_name %> - Event Details</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap">
    <link rel="stylesheet" href="/Events/eventmanager_eventdetails.css">
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/eventmanager_profile">Profile</a>
                <a href="/logout">Logout</a>
            </div>
        </header>
    </div>
    <div class="details-container">
        <a href="/eventmanager_dashboard" class="back-link">← Back to Dashboard</a>
        <div class="event-header">
            <img src="<%= event.image || '/images/default_event.jpg' %>" alt="<%= event.event_name %>">
            <h1><%= event.event_name %></h1>
        </div>
        <div class="event-content">
            <div class="left-column">
                <h2>About this Event</h2>
                <p><%= event.about_event %></p>
                <h2>Instructions</h2>
                <p><%= event.instructions %></p>
                <h2>Terms & Conditions</h2>
                <p><%= event.terms %></p>
            </div>
            <div class="right-column">
                <div class="info-card">
                    <h3>Details</h3>
                    <p><strong>Date & Time:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', { dateStyle: 'full', timeStyle: 'short' }) %></p>
                    <p><strong>Duration:</strong> <%= event.duration %></p>
                    <p><strong>Venue:</strong> <%= event.venue %>, <%= event.city %></p>
                    <p><strong>Category:</strong> <%= event.category %></p>
                    <p><strong>Language:</strong> <%= event.language %></p>
                    <p><strong>Age Limit:</strong> <%= event.age_limit === 0 ? 'All ages' : event.age_limit + '+' %></p>
                </div>
                <div class="info-card">
                    <h3>Tickets & Revenue</h3>
                    <p><strong>Price:</strong> ₹<%= event.ticket_price.toFixed(2) %></p>
                    <p><strong>Tickets Sold:</strong> <%= event.tickets_sold %> / <%= event.total_tickets %></p>
                    <p><strong>Revenue Generated:</strong> ₹<%= revenue.toFixed(2) %></p>
                    <p><strong>Status:</strong> <%= event.status %></p>
                </div>
            </div>
        </div>

        <div class="attendees-section">
            <div class="attendees-header">
                <h2>Attendee List (<%= attendees.length %> Bookings)</h2>
                <input type="text" id="attendeeSearch" onkeyup="filterAttendees()" placeholder="Search by name, email, or ticket ID..." class="search-input">
            </div>

            <% if (attendees.length > 0) { %>
            <table id="attendeeTable">
                <thead>
                    <tr>
                        <th>Ticket ID</th>
                        <th>Name</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Seats</th>
                        <th>Pet Guest</th>
                        <th>Actions</th> </tr>
                </thead>
                <tbody id="attendeeTableBody">
                    <% attendees.forEach(attendee => { %>
                        <tr>
                            <td><%= attendee.ticketId %></td>
                            <td><%= attendee.name %></td>
                            <td><%= attendee.phone_number %></td>
                            <td><%= attendee.email %></td>
                            <td><%= attendee.seats %></td>
                            <td><%= attendee.with_pet ? 'Yes' : 'No' %></td>
                            <td>
                                <button class="edit-btn"
                                        data-id="<%= attendee._id %>"
                                        data-name="<%= attendee.name %>"
                                        data-phone="<%= attendee.phone_number %>"
                                        data-event="<%= event.event_name %>"
                                        data-date="<%= new Date(event.date_time).toLocaleDateString() %>"
                                        data-seats="<%= attendee.seats %>">
                                    Edit
                                </button>
                                <button class="delete-btn" data-id="<%= attendee._id %>">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <p>No attendees have booked this event yet.</p>
            <% } %>
        </div>
    </div>
<div class="modal" id="editAttendeeModal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeEditAttendeeModal()">×</span>
        <h2>Edit Attendee</h2>
        <form id="editAttendeeForm" onsubmit="saveAttendee(event)">
            <input type="hidden" id="editAttendeeId">
            <div class="form-group">
                <label for="editName">Name</label>
                <input type="text" id="editName" required>
            </div>
            <div class="form-group">
                <label for="editPhone">Phone No</label>
                <input type="number" id="editPhone" required>
            </div>
            <div class="form-group">
                <label for="editEvent">Event<span>(Read only)</span></label>
                <input type="text" id="editEvent" readonly>
            </div>
            <div class="form-group">
                <label for="editDate">Date<span>(Read only)</span></label>
                <input type="text" id="editDate" readonly>
            </div>
            <div class="form-group">
                <label for="editSeats">Seats<span>(Read only)</span></label>
                <input type="number" id="editSeats" required readonly>
            </div>
            <button type="submit" class="book_btn">Save Changes</button>
        </form>
    </div>
</div>
    <script src="/Events/eventmanager_eventdetails.js"></script>
</body>
</html>