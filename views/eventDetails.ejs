<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title> <%=event.name%> - Happy Tails</title>
  <link rel="stylesheet" href="/Event-booking/Event-booking.css" />
</head>
<body>
  <!-- Header -->
  <header>
    <a href="/home" class="badge">Happy Tails</a>
    <div class="menu">
      <a href="/services">Services</a>
      <a href="/Events">Events</a>
      <a href="/pet_adoption">Shop</a>
      <a href="/blog">Blog</a>
      <% if (user) { %>
        <a href="/profile">Profile</a>
      <% } else { %>
        <a href="/my_login">Login/SignUp</a>
      <% } %>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container">
    <!-- Event Details -->
    <div class="event-details">
      <img src="<%=event.image%>" alt="event image"/>

      <h2>About the Event</h2>
      <p><%= event.about %></p>

      <h2>Event Guide</h2>
      <p><strong>Language:</strong> <%= event.language %></p>
      <p><strong>Duration:</strong> <%= event.duration %></p>
      <p><strong>Tickets Needed For:</strong> <%= event.age_limit %> yrs & above</p>

      <h2>Instructions</h2>
      <p><%= event.instructions %></p>

      <h2>Venue</h2>
      <div class="venue-box">
        <div class="venue-details">
          <strong><%= event.venue %></strong>
          <p><%= event.city %></p>
          <p>📞 <a href="tel:<%= event.contact %>"><%= event.contact %></a></p>
        </div>
      </div>

      <h2>Terms & Conditions</h2>
      <p><%= event.terms %></p>
    </div>

    <!-- Booking Section -->
    <div class="booking-section">
      <h2>Ready to Join?</h2>
      <p><strong>Category:</strong> <%= event.category %></p>
      <p><strong>Date & Time:</strong> <%= event.date %> | <%= event.time %></p>
      <p><strong>Price:</strong> ₹<%= event.ticket_price %></p>
      
      <button 
        id="bookNowBtn" 
        onclick="window.location.href='/event_booking_form?eventId=<%= event.id %>'">
        Book Tickets
      </button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-container">
      <div class="footer-column">
        <h3>Happy Tails</h3>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/pet_adoption">Pet Stores</a></li>
          <li><a href="/pet_accessory">Online Pet Accessories</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>Partner</h3>
        <ul>
          <li><a href="/store_signup">Pet Store Franchise</a></li>
          <li><a href="/event_manager_signup">Become an Event Manager</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>Policy</h3>
        <ul>
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Refund Policy</a></li>
          <li><a href="#">Cancellation Policy</a></li>
          <li><a href="#">Terms & Conditions</a></li>
        </ul>
        <div class="footer-social">
          <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="Facebook"></a>
          <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="Instagram"></a>
          <a href="#"><img src="/icons/youtube-icon-logo-svgrepo-com.svg" alt="YouTube"></a>
        </div>
      </div>
    </div>
  </footer>
  <script>
    console.log(1)
    console.log(event);
  </script>
</body>
</html>
