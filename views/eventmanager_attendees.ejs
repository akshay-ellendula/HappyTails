<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Manager - Attendees</title>
    <link rel="stylesheet" href="/services/service_dashboard.css">
    <link rel="stylesheet" href="/Events/eventmanager_attendees.css">
</head>

<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a>
                <a href="/logout" class="nav-link" data-page="Logout">Logout</a>
            </div>
        </header>
    </div>

    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/eventmanager_dashboard" class="nav-link" data-page="Home">Home</a></li>
                <li><a href="/eventmanager_events" class="nav-link" data-page="Events">Events</a></li>
                <li><a href="/eventmanager_attendees" class="nav-link active" data-page="Attendees">Attendees</a></li>
                <li><a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a></li>
                <li><a href="/eventmanager_analytics" class="nav-link" data-page="Analytics">Analytics</a></li>
            </ul>
        </div>

        <div class="main-content">
            <div class="welcome-section">
                <h1>Attendees</h1>
            </div>

            <!-- Past & Ongoing Attendees -->
            <div class="section">
                <h2 style="margin-bottom: 10px;">All Registered Attendees (Past & Ongoing)</h2>
                <div class="appointments">
                    <% if (typeof pastOngoingAttendees !=='undefined' && pastOngoingAttendees.length> 0) { %>
                        <% pastOngoingAttendees.forEach(attendee=> { %>
                            <% if (attendee.name) { %>
                                <div class="appointment-card">
                                    <div class="time-badge" data-time="<%= attendee.eventTime %>">
                                        <!-- Time will be set by JavaScript -->
                                    </div>
                                    <h3>
                                        <%= attendee.name %>
                                    </h3>
                                    <p><strong>Email:</strong>
                                        <%= attendee.email %>
                                    </p>
                                    <p><strong>Event:</strong>
                                        <%= attendee.event_name %> (<%= attendee.formattedDate %>)
                                    </p>
                                    <p><strong>Registration Date:</strong>
                                        <%= attendee.formattedRegDate || 'N/A' %>
                                    </p>
                                    <div class="card-actions">
                                        <div class="attendee-count">Total: <%= attendee.totalAttendees || 0 %>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                                    <% }) %>
                                        <% } else { %>
                                            <p>No past or ongoing attendees found.</p>
                                            <% } %>
                </div>
            </div>

            <!-- Upcoming Attendees -->
            <div class="section">
                <h2 style="margin-bottom: 10px;">Upcoming Events Attendees</h2>
                <div class="appointments">
                    <% if (typeof upcomingAttendees !=='undefined' && upcomingAttendees.length> 0) { %>
                        <% upcomingAttendees.forEach(attendee=> { %>
                            <% if (attendee.name) { %>
                                <div class="appointment-card">
                                    <div class="time-badge" data-time="<%= attendee.eventTime %>">
                                        <!-- Time will be set by JavaScript -->
                                    </div>
                                    <h3>
                                        <%= attendee.name %>
                                    </h3>
                                    <p><strong>Email:</strong>
                                        <%= attendee.email %>
                                    </p>
                                    <p><strong>Event:</strong>
                                        <%= attendee.event_name %> (<%= attendee.formattedDate %>)
                                    </p>
                                    <p><strong>Registration Date:</strong>
                                        <%= attendee.formattedRegDate || 'N/A' %>
                                    </p>
                                    <div class="card-actions">
                                        <div class="attendee-count">Registered: <%= attendee.seats || 0 %>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                                    <% }) %>
                                        <% } else { %>
                                            <p>No upcoming event attendees found.</p>
                                            <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Function to convert 24-hour time to 12-hour format
        function convertTo12Hour(time) {
            const [hours, minutes] = time.split(':').map(Number);
            const period = hours >= 12 ? 'PM' : 'AM';
            const adjustedHours = hours % 12 || 12; // Convert 0 to 12 for midnight
            return `${adjustedHours}:${minutes.toString().padStart(2, '0')} ${period}`;
        }

        // Apply the conversion to all time badges
        document.querySelectorAll('.time-badge').forEach(badge => {
            const time = badge.getAttribute('data-time');
            if (time) {
                badge.textContent = convertTo12Hour(time);
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            console.log('Page loaded:', window.location.pathname);
        });
    </script>
</body>

</html>