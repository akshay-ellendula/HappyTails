<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Tails - Edit Event</title>
    <link rel="stylesheet" href="/Events/eventmanager_event_edit.css">
</head>
<body>
    <div class="header">
        <h1>Happy Tails</h1>
        <div class="header-links">
            <a href="/profile" class="header-link">Profile</a>
            <a href="/logout" class="header-link">Logout</a>
        </div>
    </div>

    <div class="main-content">
        <div class="sidebar">
            <h2 class="sidebar-title">Dashboard</h2>
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item">
                    <a href="/eventmanager_dashboard" class="sidebar-menu-link">Home</a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/eventmanager_events" class="sidebar-menu-link active">Events</a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/eventmanager_attendees" class="sidebar-menu-link">Attendees</a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/eventmanager_profile" class="sidebar-menu-link">Profile</a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="/eventmanager_analytics" class="sidebar-menu-link">Analytics</a>
                </li>
            </ul>
        </div>

        <div class="content">
            <div class="content-header">
                <h1 class="content-title">Edit Event</h1>
                <a href="/eventmanager_events" class="back-btn">Back</a>
            </div>

            <div class="form-container">
                <h2 class="form-section-title">Edit Event Details</h2>
                
                <%
                    // Helper function to format date string 'Month Day, Year' to 'YYYY-MM-DD'
                    const formatDate = (dateString) => {
                        if (!dateString) return '';
                        const date = new Date(dateString);
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        return `${year}-${month}-${day}`;
                    };

                    // Helper function to format time string 'HH:MM AM/PM' to 'HH:MM' (24-hour)
                    const formatTime = (timeString) => {
                        if (!timeString) return '';
                        let [time, modifier] = timeString.split(' ');
                        let [hours, minutes] = time.split(':');
                        if (hours === '12') { // Handle 12 AM/PM
                            hours = modifier === 'AM' ? '00' : '12';
                        } else if (modifier === 'PM') {
                            hours = parseInt(hours, 10) + 12;
                        }
                        return `${String(hours).padStart(2, '0')}:${minutes}`;
                    };
                %>

                <form id="editEventForm" action="/eventmanager_events/update" method="POST" enctype="multipart/form-data">
                    <input type="hidden" id="eventId" name="id" value="<%= event.id %>">
                    <div class="form-group">
                        <label for="name">Event Name</label>
                        <input type="text" id="name" name="name" value="<%= event.name %>" required>
                    </div>  
                    <div class="form-group">
                        <label for="about">About the Event</label>
                        <textarea id="about" name="about" required><%= event.about %></textarea>
                    </div>
                    <div class="form-group">
                        <label>Event Guide</label>
                        <div class="event-guide">
                            <input type="text" id="language" name="language" value="<%= event.language %>" placeholder="Language" required>
                            <input type="text" id="duration" name="duration" value="<%= event.duration %>" placeholder="Duration (e.g., 2h)" required>
                            <input type="number" id="ticket_price" name="ticket_price" value="<%= event.ticket_price %>" placeholder="Ticket Price" step="0.01" required>
                            <input type="number" id="age_limit" name="age_limit" value="<%= event.age_limit %>" placeholder="Age Limit" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Location & Contact</label>
                        <div class="event-location">
                            <input type="text" id="venue" name="venue" value="<%= event.venue %>" placeholder="Venue" required>
                            <input type="text" id="city" name="city" value="<%= event.city %>" placeholder="City" required>
                            <input type="text" id="contact" name="contact_number" value="<%= event.contact %>" placeholder="Contact Number" required>
                    </div>
                    </div>
                    <div class="form-group">
                        <label for="instructions">Instructions</label>
                        <textarea id="instructions" name="instructions" required><%= event.instructions %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="terms">Terms and Conditions</label>
                        <textarea id="terms" name="terms" required><%= event.terms %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="category">Category</label>
                        <select id="category" name="category" required>
                            <option value="">Select Category</option>
                            <option value="Pets" <%= event.category === 'Pets' ? 'selected' : '' %>>Pets</option>
                            <option value="Music" <%= event.category === 'Music' ? 'selected' : '' %>>Music</option>
                            <option value="Dance" <%= event.category === 'Dance' ? 'selected' : '' %>>Dance</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="date">Date</label>
                        <input type="date" id="date" name="date" value="<%= formatDate(event.date) %>" required>
                    </div>

                    <div class="form-group">
                        <label for="time">Time</label>
                        <input type="time" id="time" name="time" value="<%= formatTime(event.time) %>" required>
                    </div>

                    <!-- accept updatedcapacity>tickets sold -->
                    <div class="form-group">
                        <label for="total_tickets">Capacity</label>
                        <input type="number" id="total_tickets" name="capacity" value="<%= event.total_tickets %>" placeholder="Total Capacity" required>
                    </div>

                    <div class="form-group">
                        <label >tickets sold(Read-only)</label>
                        <input type="number"  id="tickets_sold" value="<%= event.tickets_sold %>" placeholder="Tickets sold" readonly> 
                    </div>

                    <div class="form-group">
                        <label for="eventImageUpload">Event Image</label>
                        
                        <% if (event.image && event.image !== 'default_event_image.jpg') { %>
                            <img id="currentImage" class="image-upload-preview" src="<%= event.image %>" alt="Current Event Image">
                        <% } else { %>
                            <div id="currentImage" class="image-placeholder">No current image.<br>Upload new one.</div>
                        <% } %>
                        <input type="file" id="eventImageUpload" name="eventPhoto" accept="image/*" style="margin-top: 10px;">
                        <img id="imagePreview" class="image-upload-preview" src="#" alt="New Image Preview" style="display: none;">
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn-primary">Save Changes</button>
                        <a href="/eventmanager_events" class="btn-cancel">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="/Events/eventmanager_event_edit.js"></script>
</body>
</html>