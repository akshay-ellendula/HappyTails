<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Manager - Events</title>
    <link rel="stylesheet" href="/Events/eventmanager_events.css">
</head>

<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a>
                <a href="/logout" class="nav-link" data-page="Logout">Logout</a>
            </div>
        </header>
    </div>

    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/eventmanager_dashboard" class="nav-link" data-page="Home">Home</a></li>
                <li><a href="/eventmanager_events" class="nav-link active" data-page="Events">Events</a></li>
                <li><a href="/eventmanager_attendees" class="nav-link" data-page="Attendees">Attendees</a></li>
                <li><a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a></li>
                <li><a href="/eventmanager_analytics" class="nav-link" data-page="Analytics">Analytics</a></li>
            </ul>
        </div>

        <div class="main-content">
            <div class="welcome-section">
                <h1>Events</h1>
            </div>

            <!-- Previous Events -->
            <div class="section">
                <h2>Previous Events</h2>
                <div class="appointments">
                    <% if (typeof previousEvents !=='undefined' && previousEvents.length> 0) { %>
                        <% previousEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <div class="time-badge">
                                    <%= event.time %>
                                </div>
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong>
                                    <%= event.formattedDate %>
                                </p>
                                <p><strong>Registered:</strong>
                                    <%= event.attendeeCount %> Attendees
                                </p>
                                <p><strong>Revenue:</strong> $<%= (event.revenue || 0).toFixed(2) %>
                                </p>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No previous events found.</p>
                                    <% } %>
                </div>
            </div>

            <!-- Ongoing Events -->
            <div class="section">
                <h2>Ongoing Events</h2>
                <div class="appointments">
                    <% if (ongoingEvents.length> 0) { %>
                        <% ongoingEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <div class="time-badge">
                                    <%= event.time %>
                                </div>
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong>
                                    <%= event.formattedDate %>
                                </p>
                                <p><strong>Registered:</strong>
                                    <%= event.attendeeCount %> Attendees
                                </p>
                                <p><strong>Revenue:</strong> $<%= event.revenue%>
                                </p>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No ongoing events found.</p>
                                    <% } %>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="section">
                <h2>Upcoming Events</h2>
                <div class="appointments">
                    <% if (typeof upcomingEvents !=='undefined' && upcomingEvents.length> 0) { %>
                        <% upcomingEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <div class="time-badge">
                                    <%= event.time %>
                                </div>
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong>
                                    <%= event.formattedDate %>
                                </p>
                                <p><strong>Venue:</strong>
                                    <%= event.venue %>
                                </p>
                                <p><strong>Capacity:</strong>
                                    <%= event.total_tickets %>
                                </p>
                                <p><strong>Ticket Price:</strong> $<%= event.ticket_price.toFixed(2) %>
                                </p>
                                <p><strong>Description:</strong>
                                    <%= event.about_event %>
                                </p>
                                <div class="card-actions">
                                    <button class="btn-primary" onclick="openEditEvent('<%= event.id %>')">Edit</button>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No upcoming events found.</p>
                                    <% } %>
                </div>
            </div>

            <!-- Edit Event Modal -->
            <div class="modal" id="editEventModal">
                <div class="modal-content">
                    <span class="close-btn" onclick="closeEditEvent()">×</span>
                    <h2>Edit Event</h2>
                    <form id="editEventForm" action="/eventmanager_events/update" method="POST">
                        <input type="hidden" id="eventId" name="eventId">
                        <div class="form-group">
                            <label for="eventName">Event Name</label>
                            <input type="text" id="eventName" name="eventName" required>
                        </div>
                        <div class="form-group">
                            <label for="eventDate">Date</label>
                            <input type="date" id="eventDate" name="eventDate" required>
                        </div>
                        <div class="form-group">
                            <label for="eventTime">Time</label>
                            <input type="time" id="eventTime" name="eventTime" required>
                        </div>
                        <div class="form-group">
                            <label for="eventVenue">Venue</label>
                            <input type="text" id="eventVenue" name="eventVenue" required>
                        </div>
                        <div class="form-group">
                            <label for="eventCapacity">Capacity</label>
                            <input type="number" id="eventCapacity" name="eventCapacity" required>
                        </div>
                        <div class="form-group">
                            <label for="eventTicketPrice">Ticket Price ($)</label>
                            <input type="number" id="eventTicketPrice" name="eventTicketPrice" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="eventDescription">Description</label>
                            <textarea id="eventDescription" name="eventDescription" required></textarea>
                        </div>
                        <button type="submit" class="btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>

            <script>
                // Open edit event modal and populate form
                window.openEditEvent = (eventId) => {
                    const eventCard = document.getElementById(`event-${eventId}`);
                    document.getElementById('eventId').value = eventId;
                    document.getElementById('eventName').value = eventCard.querySelector('h3').textContent;
                    const dateTime = eventCard.querySelector('p:nth-child(2)').textContent.split('Date: ')[1].split(', ');
                    const [month, day, year] = dateTime[0].split(' ');
                    const formattedDate = `${year}-${monthToNumber(month)}-${day.padStart(2, '0')}`;
                    document.getElementById('eventDate').value = formattedDate;
                    document.getElementById('eventTime').value = eventCard.querySelector('.time-badge').textContent.replace(' ', '').toLowerCase();
                    document.getElementById('eventVenue').value = eventCard.querySelector('p:nth-child(3)').textContent.split('Venue: ')[1];
                    document.getElementById('eventCapacity').value = eventCard.querySelector('p:nth-child(4)').textContent.split('Capacity: ')[1];
                    document.getElementById('eventTicketPrice').value = eventCard.querySelector('p:nth-child(5)').textContent.split('Ticket Price: $')[1];
                    document.getElementById('eventDescription').value = eventCard.querySelector('p:nth-child(6)').textContent.split('Description: ')[1];
                    document.getElementById('editEventModal').style.display = 'block';
                };

                // Close edit event modal
                window.closeEditEvent = () => {
                    document.getElementById('editEventModal').style.display = 'none';
                };

                // Helper function to convert month name to number
                function monthToNumber(month) {
                    const months = {
                        'January': '01', 'February': '02', 'March': '03', 'April': '04', 'May': '05', 'June': '06',
                        'July': '07', 'August': '08', 'September': '09', 'October': '10', 'November': '11', 'December': '12'
                    };
                    return months[month];
                }
            </script>
</body>

</html>