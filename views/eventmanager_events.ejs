                        </div>
                        <div class="appointment-card">
                            <div class="time-badge">11:00 AM</div>
                            <h3>Charity Gala</h3>
                            <p><strong>Date:</strong> January 20, 2025</p>
                            <p><strong>Registered:</strong> 800 Attendees</p>
                            <p><strong>Revenue:</strong> $5,200</p>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <h2>Ongoing Events</h2>
                    <div class="appointments">
                        <div class="appointment-card">
                            <div class="time-badge">05:00 PM</div>
                            <h3>Musical Show</h3>
                            <p><strong>Date:</strong> March 17, 2025, 5:00
                                PM</p>
                            <p><strong>Registered:</strong> 900 Attendees</p>
                            <p><strong>Revenue:</strong> $2,250</p>
                        </div>
                        <div class="appointment-card">
                            <div class="time-badge">10:00 AM</div>
                            <h3>Talent Show</h3>
                            <p><strong>Date:</strong> March 17, 2025, 10:00
                                AM</p>
                            <p><strong>Registered:</strong> 100 Attendees</p>
                            <p><strong>Revenue:</strong> $500</p>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <h2>Upcoming Events</h2>
                    <div class="appointments">
                        <div class="appointment-card" id="event-1">
                            <div class="time-badge">09:30 AM</div>
                            <h3>Art Exhibition</h3>
                            <p><strong>Date:</strong> March 20, 2025, 9:30
                                AM</p>
                            <p><strong>Venue:</strong> City Gallery</p>
                            <p><strong>Capacity:</strong> 200</p>
                            <p><strong>Ticket Price:</strong> $15</p>
                            <p><strong>Description:</strong> A showcase of
                                contemporary art by local artists.</p>
                            <div class="card-actions">
                                <button class="btn-primary"
                                    onclick="openEditEvent('event-1')">Edit</button>
                            </div>
                        </div>
                        <div class="appointment-card" id="event-2">
                            <div class="time-badge">11:00 AM</div>
                            <h3>Ballet Dance</h3>
                            <p><strong>Date:</strong> March 24, 2025, 11:00
                                AM</p>
                            <p><strong>Venue:</strong> Grand Theater</p>
                            <p><strong>Capacity:</strong> 150</p>
                            <p><strong>Ticket Price:</strong> $20</p>
                            <p><strong>Description:</strong> A mesmerizing
                                ballet performance by the National Ballet
