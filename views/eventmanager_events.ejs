<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Manager - Events</title>
    <link rel="stylesheet" href="/Events/eventmanager_events.css">
</head>

<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a>
                <a href="/logout" class="nav-link" data-page="Logout">Logout</a>
            </div>
        </header>
    </div>

    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/eventmanager_dashboard" class="nav-link" data-page="Home">Home</a></li>
                <li><a href="/eventmanager_events" class="nav-link active" data-page="Events">Events</a></li>
                <li><a href="/eventmanager_attendees" class="nav-link" data-page="Attendees">Attendees</a></li>
                <li><a href="/eventmanager_profile" class="nav-link" data-page="Profile">Profile</a></li>
                <li><a href="/eventmanager_analytics" class="nav-link" data-page="Analytics">Analytics</a></li>
            </ul>
        </div>

        <div class="main-content">
            <div class="welcome-section">
                <h1>Events</h1>
            </div>

            <!-- Previous Events -->
            <div class="section">
                <h2>Past Events</h2>
                <div class="appointments">
                    <% if (typeof previousEvents !=='undefined' && previousEvents.length> 0) { %>
                        <% previousEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <a href="/event-details/<%= event.id %>" class="event-card-link">
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', { dateStyle: 'full'}) %></p>
                                <p><strong>Time:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', {timeStyle: 'short' }) %></p>
                                <p><strong>Registered:</strong>
                                    <%= event.attendeeCount %> Attendees
                                </p>
                                <p><strong>Revenue:</strong> ₹<%= (event.revenue || 0).toFixed(2) %>
                                </p> 
                            </a>
                            </div>
                            
                            <% }) %>
                                <% } else { %>
                                    <p>No past events </p>
                                    <% } %>
                </div>
            </div>

            <!-- Ongoing Events -->
            <div class="section">
                <h2>Today's Events</h2>
                <div class="appointments">
                    <% if (ongoingEvents.length> 0) { %>
                        <% ongoingEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <a href="/event-details/<%= event.id %>" class="event-card-link">
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', { dateStyle: 'full'}) %></p>
                                <p><strong>Time:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', {timeStyle: 'short' }) %></p>
                                <p><strong>Registered:</strong>
                                    <%= event.attendeeCount %> Attendees
                                </p>
                                <p><strong>Revenue:</strong> ₹<%= (event.revenue || 0).toFixed(2) %>
                                </p>
                                </a>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No events Today</p>
                                    <% } %>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="section">
                <h2>Upcoming Events</h2>
                <div class="appointments">
                    <% if (typeof upcomingEvents !=='undefined' && upcomingEvents.length> 0) { %>
                        <% upcomingEvents.forEach(event=> { %>
                            <div class="appointment-card" id="event-<%= event.id %>">
                                <h3>
                                    <%= event.event_name %>
                                </h3>
                                <p><strong>Date:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', { dateStyle: 'full'}) %></p>
                                <p><strong>Time:</strong> <%= new Date(event.date_time).toLocaleString('en-IN', {timeStyle: 'short' }) %></p>
                                <p><strong>Venue:</strong>
                                    <%= event.venue %>
                                </p>
                                <p><strong>Capacity:</strong>
                                    <%= event.total_tickets %>
                                </p>
                                <p><strong>Ticket Price:</strong> ₹<%= event.ticket_price.toFixed(2) %>
                                </p>
                                <div class="card-actions">
                                    <a href="/eventmanager_event_edit?eventId=<%= event.id %>" class="btn-primary">Edit</a>
                                    <button class="btn-danger" onclick="deleteEvent('<%= event.id %>', event)">Delete</button>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p>No upcoming events found.</p>
                                    <% } %>
                </div>
            </div>

            <script>
                // Function to convert 24-hour time to 12-hour format
                function convertTo12Hour(time) {
                    const [hours, minutes] = time.split(':').map(Number);
                    const period = hours >= 12 ? 'PM' : 'AM';
                    const adjustedHours = hours % 12 || 12; // Convert 0 to 12 for midnight
                    return `${adjustedHours}:${minutes.toString().padStart(2, '0')} ${period}`;
                }
                // MODIFIED: Updated the deleteEvent function
                async function deleteEvent(eventId, event) {
                    // This stops the click from triggering other actions, like navigating a link
                    if(event) event.stopPropagation();

                    if (!confirm('Are you sure you want to delete this event? This will also delete all associated attendees.')) return;

                    try {
                        // Use the correct API path for your backend
                        const response = await fetch(`/api/deleteEvent/${eventId}`, {
                            method: 'DELETE'
                        });

                        const data = await response.json();

                        if (response.ok) {
                            alert('Event deleted successfully!');
                            // Reload the page to see the changes
                            window.location.reload();
                        } else {
                            alert('Failed to delete event: ' + data.message);
                        }
                    } catch (error) {
                        console.error('Error deleting event:', error);
                        alert('An error occurred while deleting the event.');
                    }
                }
            </script>
</body>

</html>