<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Event Manager - Profile</title>
    <link rel="stylesheet" href="/Events/eventmanager_profile.css" />
  </head>
  <body>
    <div class="navbar">
      <header>
        <a href="/home" class="badge">Happy Tails</a>
        <div class="menu">
          <a href="/eventmanager_profile">Profile</a>
          <a href="#">Logout</a>
        </div>
      </header>
    </div>

    <div class="dashboard-container">
      <div class="sidebar">
        <h2>Dashboard</h2>
        <ul>
          <li><a href="/eventmanager_dashboard">Home</a></li>
          <li><a href="/eventmanager_events">Events</a></li>
          <li><a href="/eventmanager_attendees">Attendees</a></li>
          <li><a href="/eventmanager_profile" class="active">Profile</a></li>
          <li><a href="/eventmanager_analytics">Analytics</a></li>
        </ul>
      </div>

      <div class="main-content">
        <div class="welcome-section">
          <h1>Profile</h1>
        </div>

        <div class="section">
          <div class="appointment-card">
            <div class="profile-header">
              <img
                src="images/default-profile-account-unknown-icon-black-silhouette-free-vector.jpg"
                alt="User Profile"
                class="profile-pic-large"
              />
              <div class="profile-info">
                <h2>Jeevankumar</h2>
                <p class="member-since">Member since: January 15, 2023</p>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="firstName">First Name</label>
                <input type="text" id="firstName" value="Jeevan" readonly />
              </div>
              <div class="form-group">
                <label for="lastName">Last Name</label>
                <input type="text" id="lastName" value="Kumar" readonly />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email</label>
                <input
                  type="email"
                  id="email"
                  value="jeevan.kumar@happytails.com"
                  readonly
                />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="text" id="phone" value="(555) 123-4567" readonly />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="role">Role</label>
                <input type="text" id="role" value="Event Manager" readonly />
              </div>
              <div class="form-group">
                <label for="eventType">Event Specialization</label>
                <input
                  type="text"
                  id="eventType"
                  value="Charity & Adoption Events"
                  readonly
                />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="license">License Number</label>
                <input
                  type="text"
                  id="license"
                  value="EVENT-12345-AB"
                  readonly
                />
              </div>
              <div class="form-group">
                <label for="eventsManaged">Events Managed</label>
                <input type="text" id="eventsManaged" value="34" readonly />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="bio">Bio</label>
                <textarea id="bio" readonly>
Jeevan Kumar is an experienced event manager specializing in pet adoption and charity events. With over 5 years of experience in the field, he has successfully organized numerous community engagement events that have resulted in high adoption rates and substantial charitable contributions.</textarea
                >
              </div>
            </div>

            <div class="change-password">
              <h2>Change Password</h2>
              <div class="form-group">
                <label for="currentPassword">Current Password</label>
                <input
                  type="password"
                  id="currentPassword"
                  placeholder="Enter current password"
                />
              </div>
              <div class="form-group">
                <label for="newPassword">New Password</label>
                <input
                  type="password"
                  id="newPassword"
                  placeholder="Enter new password"
                />
              </div>
              <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <input
                  type="password"
                  id="confirmPassword"
                  placeholder="Confirm new password"
                />
              </div>
              <div class="password-requirements">
                <p>Password must contain:</p>
                <ul>
                  <li>At least 8 characters</li>
                  <li>At least one uppercase letter</li>
                  <li>At least one number</li>
                  <li>At least one special character</li>
                </ul>
              </div>
              <button class="btn-secondary">Update Password</button>
            </div>

            <button class="btn-primary" onclick="openEditProfile()">
              Edit Profile
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal" id="editProfileModal">
      <div class="modal-content">
        <span class="close-btn" onclick="closeEditProfile()">×</span>
        <h2>Edit Profile</h2>
        <form id="editProfileForm" onsubmit="saveProfile(event)">
          <div class="form-row">
            <div class="form-group">
              <label for="editFirstName">First Name</label>
              <input type="text" id="editFirstName" value="Jeevan" required />
            </div>
            <div class="form-group">
              <label for="editLastName">Last Name</label>
              <input type="text" id="editLastName" value="Kumar" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="editEmail">Email</label>
              <input
                type="email"
                id="editEmail"
                value="jeevan.kumar@happytails.com"
                required
              />
            </div>
            <div class="form-group">
              <label for="editPhone">Phone Number</label>
              <input
                type="text"
                id="editPhone"
                value="(555) 123-4567"
                required
              />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="editEventType">Event Specialization</label>
              <input
                type="text"
                id="editEventType"
                value="Charity & Adoption Events"
                required
              />
            </div>
            <div class="form-group">
              <label for="editLicense">License Number</label>
              <input
                type="text"
                id="editLicense"
                value="EVENT-12345-AB"
                required
              />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="editProfilePic">Profile Picture</label>
              <div class="file-input-container">
                <input
                  type="file"
                  id="editProfilePic"
                  accept="image/*"
                  class="file-input"
                />
                <label for="editProfilePic" class="file-input-label"
                  >Choose File</label
                >
                <span class="file-name">No file chosen</span>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label for="editBio">Professional Bio</label>
            <textarea id="editBio" required>
Jeevan Kumar is an experienced event manager specializing in pet adoption and charity events. With over 5 years of experience in the field, he has successfully organized numerous community engagement events that have resulted in high adoption rates and substantial charitable contributions.</textarea
            >
          </div>
          <button type="submit" class="btn-primary">Save Changes</button>
          <button
            type="button"
            class="btn-secondary"
            onclick="closeEditProfile()"
          >
            Cancel
          </button>
        </form>
      </div>
    </div>

    <script>
      // Form validation for Event Manager Profile
      document.addEventListener("DOMContentLoaded", () => {
        // Handle file input display
        const fileInput = document.getElementById("editProfilePic");
        if (fileInput) {
          fileInput.addEventListener("change", function () {
            const fileName = this.files[0]
              ? this.files[0].name
              : "No file chosen";
            this.nextElementSibling.nextElementSibling.textContent = fileName;
          });
        }

        // Add validation to password form
        const passwordForm = document.querySelector(
          ".change-password .btn-secondary"
        );
        if (passwordForm) {
          passwordForm.addEventListener("click", validatePasswordForm);
        }

        // Add validation to edit profile form
        const editProfileForm = document.getElementById("editProfileForm");
        if (editProfileForm) {
          editProfileForm.addEventListener("submit", function (event) {
            if (!validateEditProfileForm(event)) {
              event.preventDefault();
            }
          });
        }

        // Format existing phone number to Indian format if it exists
        const phoneField = document.getElementById("phone");
        if (phoneField && phoneField.value) {
          phoneField.value = formatIndianPhoneNumber(phoneField.value);
        }
      });

      // Open modal
      window.openEditProfile = () => {
        document.getElementById("editProfileModal").style.display = "block";

        // Format phone number in edit form to raw digits for editing
        const phoneValue = document.getElementById("phone").value;
        const editPhone = document.getElementById("editPhone");
        editPhone.value = phoneValue.replace(/\D/g, "");
      };

      // Close modal
      window.closeEditProfile = () => {
        document.getElementById("editProfileModal").style.display = "none";
      };

      // Save profile with validation
      window.saveProfile = (event) => {
        event.preventDefault();

        if (validateEditProfileForm(event)) {
          const firstName = document.getElementById("editFirstName").value;
          const lastName = document.getElementById("editLastName").value;
          const email = document.getElementById("editEmail").value;
          const phone = document.getElementById("editPhone").value;
          const eventType = document.getElementById("editEventType").value;
          const license = document.getElementById("editLicense").value;
          const bio = document.getElementById("editBio").value;

          document.getElementById("firstName").value = firstName;
          document.getElementById("lastName").value = lastName;
          document.getElementById("email").value = email;
          document.getElementById("phone").value =
            formatIndianPhoneNumber(phone);
          document.getElementById("eventType").value = eventType;
          document.getElementById("license").value = license;
          document.getElementById("bio").value = bio;
          document.querySelector(
            ".profile-info h2"
          ).textContent = `${firstName} ${lastName}`;

          alert("Profile updated successfully!");
          closeEditProfile();
        }
      };

      // Format to Indian phone number: +91 XXXXX XXXXX
      function formatIndianPhoneNumber(phoneNumber) {
        // Strip all non-digits
        const digitsOnly = phoneNumber.replace(/\D/g, "");

        // Check if it's a 10-digit number
        if (digitsOnly.length === 10) {
          return `+91 ${digitsOnly.substring(0, 5)} ${digitsOnly.substring(5)}`;
        }
        // If it already has country code (91 + 10 digits)
        else if (
          digitsOnly.length === 12 &&
          digitsOnly.substring(0, 2) === "91"
        ) {
          return `+91 ${digitsOnly.substring(2, 7)} ${digitsOnly.substring(7)}`;
        }
        // Return original if it doesn't match expected patterns
        return phoneNumber;
      }

      // Validate phone number (Indian format: 10 digits starting with 6, 7, 8, or 9)
      function validateIndianPhoneNumber(phoneNumber) {
        const digitsOnly = phoneNumber.replace(/\D/g, "");

        // Remove country code if present
        let number = digitsOnly;
        if (digitsOnly.length === 12 && digitsOnly.substring(0, 2) === "91") {
          number = digitsOnly.substring(2);
        }

        // Check if it's a valid Indian mobile number
        const regex = /^[6-9]\d{9}$/;
        return regex.test(number);
      }

      // Validate email format
      function validateEmail(email) {
        const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return regex.test(email);
      }

      // Validate password criteria
      function validatePassword(password) {
        // At least 8 characters
        if (password.length < 8) return false;

        // At least one uppercase letter
        if (!/[A-Z]/.test(password)) return false;

        // At least one number
        if (!/\d/.test(password)) return false;

        // At least one special character
        if (!/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password))
          return false;

        return true;
      }

      // Validate the password form
      function validatePasswordForm() {
        const currentPassword =
          document.getElementById("currentPassword").value;
        const newPassword = document.getElementById("newPassword").value;
        const confirmPassword =
          document.getElementById("confirmPassword").value;

        // Check if current password is entered
        if (!currentPassword) {
          alert("Please enter your current password");
          return false;
        }

        // Check if new password meets criteria
        if (!validatePassword(newPassword)) {
          alert("Your new password does not meet the requirements");
          return false;
        }

        // Check if passwords match
        if (newPassword !== confirmPassword) {
          alert("New password and confirm password do not match");
          return false;
        }

        alert("Password updated successfully!");

        // Clear form fields
        document.getElementById("currentPassword").value = "";
        document.getElementById("newPassword").value = "";
        document.getElementById("confirmPassword").value = "";

        return true;
      }

      // Validate the edit profile form
      function validateEditProfileForm() {
        // Get form fields
        const firstName = document.getElementById("editFirstName").value;
        const lastName = document.getElementById("editLastName").value;
        const email = document.getElementById("editEmail").value;
        const phone = document.getElementById("editPhone").value;
        const eventType = document.getElementById("editEventType").value;
        const license = document.getElementById("editLicense").value;
        const bio = document.getElementById("editBio").value;

        // Validate name fields
        if (firstName.trim() === "") {
          alert("Please enter your first name");
          return false;
        }

        if (lastName.trim() === "") {
          alert("Please enter your last name");
          return false;
        }

        // Validate email
        if (!validateEmail(email)) {
          alert("Please enter a valid email address");
          return false;
        }

        // Validate phone number
        if (!validateIndianPhoneNumber(phone)) {
          alert(
            "Please enter a valid Indian mobile number (10 digits starting with 6, 7, 8, or 9)"
          );
          return false;
        }

        // Validate other required fields
        if (eventType.trim() === "") {
          alert("Please enter your event specialization");
          return false;
        }

        if (license.trim() === "") {
          alert("Please enter your license number");
          return false;
        }

        if (bio.trim() === "") {
          alert("Please enter your professional bio");
          return false;
        }

        return true;
      }
    </script>
  </body>
</html>
