<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>more-details</title>
  <link rel="stylesheet" href="/moredetails/more-details.css">
</head>
<body>
    <div class="navbar">
      <header>
        <a href="/home" class="badge">Happy Tails</a>

        <div class="menu">
            <a href="/services.">Services</a>
            <a href="/Events">Events</a>
            <a href="/pet_adoption">Shop</a>
            <a href="/blog">Blog</a>
            <a href="/Events">Events</a>
            <% if (user) { %>
              <a href="/profile">Profile</a>
            <% } else { %>
                <a href="/my_login">Login/SignUp</a>
            <% } %>
        </div>

        <div class="menu-icon" id="menuIcon">
          <img src="/icons/hamburger-svgrepo-com.svg" alt="Menu" height="25px" />
        </div>

        <div class="side-navbar" id="sideNavbar">
          <a href="javascript:void(0)" class="close-btn" id="closeBtn">&times;</a>
          <a href="/pet_adoption">Shop</a>
          <a href="/pet_accessory">Pet Essentials</a>  
          <a href="/Events">Events</a>      
          <a href="/services">Services</a>
          <a href="/blog">Blog</a>
          <% if (user) { %>
            <a href="/profile">Profile</a>
          <% } else { %>
              <a href="/login_signup">Login/SignUp</a>
          <% } %>
        </div>
      </header>
    </div>


    <div class="container">
      <div class="image_details">
        <div class="image-gallery">
          <div class="slider-wrapper">
            <div class="slider">
              <img id="slide-1" src="/images/pup.avif" alt="dog1">
              <img id="slide-2" src="/images/pup.avif" alt="dog2">
              <img id="slide-3" src="/images/pup.avif" alt="dog3">
              <img id="slide-4" src="/images/pup.avif" alt="dog4">
            </div>
            <div class="slider-nav">
              <a href="#slide-1"></a>
              <a href="#slide-2"></a>
              <a href="#slide-3"></a>
              <a href="#slide-4"></a>
            </div>
          </div>
        </div>

        <div class="details">
          <h2 class="sub-heading">Details</h2>
          <div class="dog-details">
            <p><strong>Breed:</strong> German Shepherd</p>
            <p><strong>Gender:</strong> Male</p>
            <p><strong>Vaccinated:</strong> yes</p>
            <p><strong>Age:</strong> Adulthood</p>
          </div>

          <hr/>
          <h2 class="sub-heading">More Info</h2>
          <div class="more-details">
            <p>Not Spayed</p>
            <p>Shots upto date</p>
            <p>Needs Loving adopter</p>
            <p>Good with cats</p>
            <p>Good with dogs</p>
            <p>Good with kids</p>
          </div>

          <hr>

          <div class="contact-info">
            <h2>Contact Info</h2>
            <p><strong>Name:</strong> Gautam Thota</p>
            <p><strong>Location:</strong> Delhi, Delhi</p>
            <p><strong>Number:</strong> <a href="tel:1234567890">1234567890</a></p>
            <div class="share">
              <h2>Share with friends</h2>
              <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="facebook" height="50px"></a>
              <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="instagram" height="50px"></a>
              <a href="#"><img src="/icons/twitter-svgrepo-com.svg" alt="twitter" height="50px"></a>
              <a href="#"><img src="/icons/whatsapp-color-svgrepo-com.svg" alt="whatsapp" height="50px"></a>
            </div>
          </div>
        </div>
      </div>

      <div class="chat_location">

        <div class="price-container">
          <div class="price">
            <h1>₹7000</h1>
            <img>
          </div>
          <div class="description">
            <p>Luna is a beautiful and intelligent German Shepherd who has been a cherished member of our family. 
              Unfortunately, due to unforeseen circumstances, we need to find her a new loving home</p>
          </div>
        </div>

        <hr>

        <div class="chat">
          <div class="profile">
            <img src="/icons/profile-circle-svgrepo-com (1).svg" alt="profile pic" height="50px">
            <h2>Name Of the Seller.</h2>
          </div>

          <div class="chat_button">
            <button>Chat with seller</button>
          </div>
        </div>

        <hr>

        <div class="location">

          <h2>User Location</h2>
          <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.4964800577685!2d80.024273!3d13.5554717!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a4d773f1e0f8721%3A0xadb0842ffc2719e4!2sIndian+Institute+of+Information+Technology!5e0!3m2!1sen!2sin!4v1700000000000"
          width="100%" height="500px" style="border:0;" allowfullscreen="" loading="lazy">
          </iframe>
        </div>
      </div>

    </div>

    <footer class="footer">
      <div class="footer-container">
        
        <div class="footer-column">
          <h3>Happy Tails</h3>
          <ul>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/pet_adoption">Pet Stores</a></li>
            <li><a href="/pet_accessory">Online Pet Accessories</a></li>
          </ul>
        </div>
        
        
        <div class="footer-column">
          <h3>Services</h3>
          <ul>
            <li><a href="/services">Pet Grooming</a></li>
            <li><a href="/services">Dog Training</a></li>
            <li><a href="/services">Vet Consultation</a></li>
          </ul>
        </div>
        

        <div class="footer-column">
          <h3>Partner</h3>
          <ul>
            <li><a href="/service_login">Become a Groomer</a></li>
            <li><a href="/service_login">Become a Dog Trainer</a></li>
            <li><a href="/service_login">Become Vet partner</a></li>
            <li><a href="#">Pet Store Franchise</a></li>
          </ul>
        </div>
        
        <div class="footer-column">
          <h3>Policy</h3>
          <ul>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Refund Policy</a></li>
            <li><a href="#">Cancellation Policy</a></li>
            <li><a href="#">Terms & Conditions</a></li>
          </ul>
          <div class="footer-social">
            <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="Facebook"></a>
            <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="Instagram"></a>
            <a href="#"><img src="/icons/youtube-icon-logo-svgrepo-com.svg" alt="YouTube"></a>
          </div>
        </div>
      </div>
  </footer>
  

  <script>
    document.getElementById('menuIcon').addEventListener('click', function() {
          document.getElementById('sideNavbar').classList.toggle('open');
    });

    document.getElementById('closeBtn').addEventListener('click', function() {
        document.getElementById('sideNavbar').classList.remove('open');
    });
  </script>
</body>
</html>