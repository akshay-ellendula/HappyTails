<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Orders</title>
    <link rel="stylesheet" href="/User Profile/myorders_profile.css">
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/pet_accessory">Pet Essentials</a>
                <a href="/Events">Events</a>
                <a href="/profile">Profile</a>
            </div>
            <div class="menu-icon" id="menuIcon">
                <img src="/icons/hamburger-svgrepo-com.svg" alt="Menu" height="25px" />
            </div>
            <div class="side-navbar" id="sideNavbar">
                <a href="javascript:void(0)" class="close-btn" id="closeBtn">&times;</a>
                <a href="/pet_accessory">Pet Essentials</a>
                <a href="/Events">Events</a>
                <a href="/profile">Profile</a>
            </div>
        </header>
    </div>

    <div class="sidebar_btn">
        <button id="sidebar_btn">More</button>
    </div>

    <div class="mobile_sidebar">
        <a href="javascript:void(0)" class="close-btn" id="mobile_sidebar_close-btn">&times;</a>
        <div class="myProfile sidebar_divs"><a href="/profile">My Profile</a></div>
        <div class="myOrders sidebar_divs"><a href="/my_orders">My Orders</a></div>
        <div class="myEvents sidebar_divs"><a href="/my_events">My Events</a></div>
        <div class="logout sidebar_divs"><a href="/logout">Logout</a></div>
    </div>

    <div class="sidebar">
        <div class="myProfile sidebar_divs"><a href="/profile">My Profile</a></div>
        <div class="myOrders sidebar_divs"><a href="/my_orders">My Orders</a></div>
        <div class="myEvents sidebar_divs"><a href="/my_events">My Events</a></div>
        <div class="logout sidebar_divs"><a href="/logout">Logout</a></div>
    </div>

    <div class="container">
        <div class="current_orders">
            <h2>Current Orders</h2>
        </div>
        <div class="previous_orders">
            <h2 style="margin-bottom: 30px;">Previous Orders</h2>
            <div class="order_container"></div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Navbar / Sidebar toggles
            document.getElementById('menuIcon').addEventListener('click', () =>
                document.getElementById('sideNavbar').classList.toggle('open'));
            document.getElementById('closeBtn').addEventListener('click', () =>
                document.getElementById('sideNavbar').classList.remove('open'));
            document.getElementById('sidebar_btn').addEventListener('click', () =>
                document.querySelector('.mobile_sidebar').classList.toggle('open'));
            document.querySelector('#mobile_sidebar_close-btn').addEventListener('click', () =>
                document.querySelector('.mobile_sidebar').classList.remove('open'));

            // Fetch orders
            fetch('/api/my_orders', {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    alert('Error fetching orders: ' + data.message);
                    return;
                }
                console.log('Orders data received:', data.orders);
                const orders = data.orders;
                const currentOrdersContainer = document.querySelector('.current_orders');
                const previousOrdersContainer = document.querySelector('.previous_orders .order_container');

                currentOrdersContainer.innerHTML = '<h2>Current Orders</h2>';
                previousOrdersContainer.innerHTML = '';

                if (orders.length === 0) {
                    currentOrdersContainer.innerHTML += '<p>No current orders.</p>';
                    previousOrdersContainer.innerHTML = '<p>No previous orders.</p>';
                    return;
                }

                orders.forEach(order => {
                    const item = order.items[0]; // Show first item as preview
                    let imageHtml = '';

                    if (item.image_data) {
                        if (item.image_data.startsWith('data:')) {
                            imageHtml = `<img src="${item.image_data}" alt="${item.product_name}" />`;
                        } else if (item.image_data.startsWith('/images/')) {
                            // Ignore fake default image path
                            imageHtml = '';
                        } else {
                            imageHtml = `<img src="data:image/jpeg;base64,${item.image_data}" alt="${item.product_name}" />`;
                        }
                    }
                
                    const orderCard = `
                        <div class="order_card">
                            <div class="order_left_container">
                                <h2>${order.status === 'Delivered'
                                    ? 'Delivered on ' + new Date(order.delivery_date).toLocaleDateString()
                                    : 'Order Placed'}</h2>
                                <div class="order_image">
                                    ${imageHtml}
                                </div>
                            </div>
                            <div class="order_details">
                                <h2>${item.product_name} ${order.items.length > 1 ? 'and more' : ''}</h2>
                                <h3>Order ID: ${order._id}</h3>
                                <p><span>Order Date:</span> ${new Date(order.order_date).toLocaleDateString()}</p>
                                <p><span>Delivery Date:</span> ${order.delivery_date ? new Date(order.delivery_date).toLocaleDateString() : 'Pending'}</p>
                                <p><span>Order Status:</span> ${order.status}</p>
                                <div class="button_container">
                                    <button onclick="buyAgain('${order.id}')">Buy Again</button>
                                    <button onclick="window.location.href='/track_package/${order.id}'">Track Order</button>
                                    ${order.status === 'Delivered' ? '<button>Return Product</button>' : ''}
                                </div>
                            </div>
                        </div>
                    `;
                    
                    if (order.status !== 'Delivered') {
                        currentOrdersContainer.insertAdjacentHTML('beforeend', orderCard);
                    } else {
                        previousOrdersContainer.insertAdjacentHTML('beforeend', orderCard);
                    }
                });             
            })
            .catch(error => console.error('Error fetching orders:', error));
        });

        function buyAgain(orderId) {
            fetch(`/api/orders/${orderId}/reorder`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    let cart = JSON.parse(localStorage.getItem('cart')) || [];

                    // Add each item from the reorder to the cart
                    data.cart.forEach(reorderItem => {
                        const existingItemIndex = cart.findIndex(cartItem => 
                            cartItem.product_id === reorderItem.product_id && 
                            cartItem.variant_id === reorderItem.variant_id &&
                            cartItem.size === reorderItem.size &&
                            cartItem.color === reorderItem.color
                        );

                        if (existingItemIndex > -1) {
                            cart[existingItemIndex].quantity += reorderItem.quantity;
                        } else {
                            // Store item with image data if available
                            cart.push({
                                product_id: reorderItem.product_id,
                                variant_id: reorderItem.variant_id,
                                product_name: reorderItem.product_name,
                                quantity: reorderItem.quantity,
                                price: reorderItem.price,
                                size: reorderItem.size,
                                color: reorderItem.color,
                                image_data: reorderItem.image_data // Include image data for cart display
                            });
                        }
                    });

                    localStorage.setItem('cart', JSON.stringify(cart));
                    alert('Items added to cart successfully!');
                    window.location.href = '/pet_accessory';
                } else {
                    alert('Error reordering: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error adding items to cart. Please try again.');
            });
        }
    </script>
</body>
</html>
