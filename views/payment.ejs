<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment | Happy Tails</title>
    <link rel="stylesheet" href="/pet accessory/pet-accessory.css">
    <style>
        /* General page layout and colors from the theme */
        body {
            background-color: #effe8b;
            font-family: "Outfit", sans-serif;
            color: #1a1a1a;
        }

        /* Payment container and form styling */
        .payment-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 40px;
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        }

        .payment-container h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .payment-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }
        
        .form-group label {
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-group input {
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #1a1a1a;
            box-shadow: 0 0 5px rgba(26, 26, 26, 0.2);
        }

        .card-details-row {
            display: flex;
            gap: 15px;
        }
        
        .card-details-row .form-group {
            flex: 1;
        }

        /* Order summary styling */
        .order-summary {
            background-color: #f9f9f9;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 30px;
        }
        
        .order-summary h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px dashed #ccc;
        }

        .order-summary-item {
            display: flex;
            justify-content: space-between;
            font-size: 1.1rem;
            margin-bottom: 10px;
        }

        .order-total {
            display: flex;
            justify-content: space-between;
            font-size: 1.3rem;
            font-weight: 700;
            border-top: 1px solid #ccc;
            padding-top: 15px;
            margin-top: 15px;
        }

        /* Button styling */
        .pay-button {
            width: 100%;
            padding: 15px;
            background-color: #1a1a1a;
            color: #effe8b;
            border: none;
            border-radius: 30px;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        
        .pay-button:hover {
            background-color: #333;
            transform: translateY(-2px);
        }

        .pay-button:active {
            transform: translateY(0);
        }

        .pay-button:disabled {
            background-color: #666;
            cursor: not-allowed;
            transform: none;
        }
    </style>
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
        </header>
    </div>

    <div class="payment-container">
        <h2>Complete Your Purchase</h2>
        
        <div class="order-summary">
            <h3>Order Summary</h3>
            <div class="order-summary-item">
                <span>Subtotal:</span>
                <span>₹<%= subtotal %></span>
            </div>
            <div class="order-summary-item">
                <span>Charge (4%):</span>
                <span>₹<%= charge %></span>
            </div>
            <div class="order-total">
                <span>Total:</span>
                <span>₹<%= total %></span>
            </div>
        </div>

        <form class="payment-form" id="paymentForm">
            <h3>Payment Information</h3>
            <div class="form-group">
                <label for="card-number">Card Number</label>
                <input type="text" id="card-number" name="cardNumber" required maxlength="19" placeholder="xxxx xxxx xxxx xxxx">
            </div>
            <div class="card-details-row">
                <div class="form-group">
                    <label for="expiry-date">Expiry Date (MM/YY)</label>
                    <input type="text" id="expiry-date" name="expiryDate" placeholder="MM/YY" required>
                </div>
                <div class="form-group">
                    <label for="cvc">CVV</label>
                    <input type="text" id="cvc" name="cvc" required>
                </div>
            </div>
            <button type="submit" class="pay-button" id="payButton">Pay Now</button>
        </form>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const cardNumberInput = document.getElementById('card-number');
        const cvvInput = document.getElementById('cvc');
        const expiryDateInput = document.getElementById('expiry-date');
        const form = document.getElementById('paymentForm');
        const payButton = document.getElementById('payButton');

        // Card Number Formatting
        cardNumberInput.addEventListener('input', (event) => {
            let { value } = event.target;
            value = value.replace(/\D/g, '').slice(0, 16); // Remove all non-digits and limit to 16
            value = value.replace(/(\d{4})/g, '$1 ').trim();
            event.target.value = value;
        });
        
        // Expiry Date Formatting
        expiryDateInput.addEventListener('input', (event) => {
            let { value } = event.target;
            value = value.replace(/\D/g, ''); // Remove all non-digits
            if (value.length >= 2) {
                event.target.value = value.slice(0, 2) + '/' + value.slice(2, 4);
            }
        });
        
        // CVV Formatting (limit to 3 digits)
        cvvInput.addEventListener('input', (event) => {
            let { value } = event.target;
            event.target.value = value.replace(/\D/g, '').slice(0, 3);
        });

        // Form Submission Validation
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            
            const originalText = payButton.textContent;
            payButton.textContent = 'Processing...';
            payButton.disabled = true;

            let isValid = true;
            let errorMessage = '';

            const cardNumberValue = cardNumberInput.value.replace(/\s/g, '');
            const expiryDateValue = expiryDateInput.value;
            const cvvValue = cvvInput.value;

            // Card Number Validation
            if (cardNumberValue.length !== 16) {
                errorMessage += 'Card number must be 16 digits long.\n';
                isValid = false;
            }

            // Expiry Date Validation
            const [month, year] = expiryDateValue.split('/');
            const currentYear = new Date().getFullYear().toString().slice(-2);
            const currentMonth = new Date().getMonth() + 1;
            
            if (!expiryDateValue.match(/^\d{2}\/\d{2}$/)) {
                errorMessage += 'Please enter a valid expiry date in MM/YY format.\n';
                isValid = false;
            } else {
                const enteredMonth = parseInt(month, 10);
                const enteredYear = parseInt(year, 10);

                if (enteredMonth < 1 || enteredMonth > 12) {
                    errorMessage += 'Invalid month. Please enter a value between 01 and 12.\n';
                    isValid = false;
                } else if (enteredYear < parseInt(currentYear, 10) || (enteredYear === parseInt(currentYear, 10) && enteredMonth < currentMonth)) {
                    errorMessage += 'This card has expired. Please enter a valid future date.\n';
                    isValid = false;
                }
            }

            // CVV Validation
            if (cvvValue.length !== 3 || isNaN(cvvValue)) {
                errorMessage += 'CVV must be a 3-digit number.\n';
                isValid = false;
            }

            if (!isValid) {
                payButton.textContent = originalText;
                payButton.disabled = false;
                alert(errorMessage);
                return;
            }

            try {
                const response = await fetch('/process-payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        cardNumber: cardNumberValue,
                        expiryDate: expiryDateValue,
                        cvc: cvvValue
                    })
                });

                const result = await response.json();

                if (result.success) {
                    window.location.href = result.redirectUrl;
                } else {
                    alert(result.message || 'Payment failed. Please try again.');
                    payButton.textContent = originalText;
                    payButton.disabled = false;
                }
            } catch (error) {
                console.error('Payment submission error:', error);
                alert('Network error. Please try again.');
                payButton.textContent = originalText;
                payButton.disabled = false;
            }
        });
    });
    </script>
</body>
</html>