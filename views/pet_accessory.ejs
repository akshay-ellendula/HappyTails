    <div class="main_container">
        <div class="filter_container">
            <h2 style="margin-bottom: 40px;">Filter by</h2>
            <div class="product_type filters">

                <div class="heading_button">
                    <h3>Product Type</h3>
                    <button class="expand-button">+</button>
                </div>

                <p class="hidden">
                    <input type="checkbox" id="pet_beds" name="product-type" value="Pet Beds">
                    <label for="pet_beds">Pet Beds</label>
                </p>


                <p class="hidden">
                    <input type="checkbox" id="pet_food" name="product-type" value="Pet Food">
                    <label for="pet_food">Pet Food</label>
                </p>

                <p class="hidden">
                    <input type="checkbox" id="grooming_supplies" name="product-type" value="Grooming Supplies">
                    <label for="grooming_supplies">Grooming Supplies</label>
                </p>
            </div>


            <hr>


            <div class="price filters">
                <div class="heading_button">
                    <h3>Price</h3>
                    <button class="expand-button">+</button>
                </div>
                
                
                <input type="range" id="price" class="hidden" name="price" min="0" max="5000" value="100" style="width: 100%;">
                
                <div class="price_labels hidden">
                    <span id="min-price">₹250.00</span>
                    <span id="max-price">₹5000.00</span>    
                </div>
                
            </div>


            <hr>


            <div class="color filters">
                <div class="heading_button">
                    <h3>Color</h3>
                    <button class="expand-button">+</button>
                </div>
                <p class="hidden">
                    <input type="checkbox" id="brown" name="color" value="Brown">
                    <label for="brown">Brown</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="grey" name="color" value="Grey">
                    <label for="grey">Grey</label>
                </p>
            </div>


            <hr>


            <div class="size filters">
                <div class="heading_button">
                    <h3>Size</h3>
                    <button class="expand-button">+</button>
                </div>
                <p class="hidden">
                    <input type="checkbox" id="small" name="size" value="small">
                    <label for="small">Small</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="medium" name="size" value="medium">
                    <label for="medium">Medium</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="large" name="size" value="large">
