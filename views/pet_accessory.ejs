    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Menu Toggle for Side Navbar
            const menuIcon = document.getElementById('menuIcon');
            const sideNavbar = document.getElementById('sideNavbar');
            const closeBtn = document.getElementById('closeBtn');

            menuIcon.addEventListener('click', function () {
                sideNavbar.classList.toggle('open');
            });

            closeBtn.addEventListener('click', function () {
                sideNavbar.classList.remove('open');
            });

            // Cart Toggle (Desktop and Mobile)
            const cart = document.getElementById('cart');
            const cartBtn = document.getElementById('cart_btn');
            const mobileCartBtn = document.getElementById('mobile_cart_btn');
            const cartCloseBtn = document.getElementById('CartcloseBtn');

            cartBtn.addEventListener('click', function () {
                cart.classList.toggle('open');
            });

            mobileCartBtn.addEventListener('click', function () {
                sideNavbar.classList.remove('open');
                cart.classList.toggle('open');
            });

            cartCloseBtn.addEventListener('click', function () {
                cart.classList.remove('open');
            });

            // Filter Expand/Collapse
            const expandButtons = document.querySelectorAll('.expand-button');
            expandButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const filterSection = this.closest('.filters');
                    const options = filterSection.querySelectorAll('p, #price, .price_labels');
                    options.forEach(option => {
                        option.classList.toggle('hidden');
                    });
                    this.textContent = this.textContent === '+' ? '-' : '+';
                });
            });

            // Product Card Click Redirect
            document.querySelectorAll('.product_card').forEach(card => {
                card.addEventListener('click', function () {
                    window.location.href = "/pet_product_details";
                });
            });

            // Mobile Filter Toggle
            const filterBtn = document.querySelector(".filter_btn");
            const filters = document.querySelector(".filter_container");
            const closeFiltersBtn = document.createElement("button");
            closeFiltersBtn.innerText = "✖ Close";
            closeFiltersBtn.classList.add("close-filters");
            filters.prepend(closeFiltersBtn);

            filterBtn.addEventListener("click", function () {
                filters.classList.add("show");
            });

            closeFiltersBtn.addEventListener("click", function () {
                filters.classList.remove("show");
            });

            // Cart Quantity and Price Calculation (Fixed for Multiple Items)
            const cartProducts = document.querySelectorAll('.cart_product');
            cartProducts.forEach(product => {
                const quantityInput = product.querySelector('input[type="number"]');
                const unitPriceElement = product.querySelector('.unit-price'); // Use class instead of id
                const totalPriceElement = product.querySelector('.total-price'); // Use class instead of id

                // Ensure unique class names (update HTML below to match)
                quantityInput.addEventListener("input", function () {
                    const unitPrice = parseInt(unitPriceElement.textContent) || 0;
                    const quantity = parseInt(quantityInput.value) || 1;
                    const totalPrice = unitPrice * quantity;
                    totalPriceElement.textContent = totalPrice;

                    // Update subtotal
                    updateSubtotal();
                });
            });

            // Function to calculate and update subtotal
            function updateSubtotal() {
                let subtotal = 0;
                document.querySelectorAll('.total-price').forEach(total => {
                    subtotal += parseInt(total.textContent) || 0;
                });
                document.querySelector('.subtotal span').textContent = subtotal;
            }

            // Initial subtotal calculation
            updateSubtotal();
        });
    </script>
