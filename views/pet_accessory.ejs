<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet Accessory</title>
    <link rel="stylesheet" href="/pet accessory/pet-accessory.css">
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="/Events">Events</a>
                <a href="/blog">Blog</a>
                <a href="#" id="cart_btn">Cart</a>
                <% if (user) { %>
                    <a href="/profile">Profile</a>
                <% } else { %>
                    <a href="/my_login">Login/SignUp</a>
                <% } %>
            </div>
            <div class="menu-icon" id="menuIcon">
                <img src="/icons/hamburger-svgrepo-com.svg" alt="Menu" height="25px" />
            </div>
            <div class="side-navbar" id="sideNavbar">
                <a href="javascript:void(0)" class="close-btn" id="closeBtn">×</a>       
                <a href="/Events">Events</a>
                <a href="/blog">Blog</a>
                <a href="#" id="mobile_cart_btn">Cart</a>
                <% if (user) { %>
                    <a href="/profile">Profile</a>
                <% } else { %>
                    <a href="/my_login">Login/SignUp</a>
                <% } %>
            </div>
            <div id="cart" class="cart">
                <div class="cart_wrapper">
                    <div class="cart_header">
                        <h2>Cart</h2>
                        <a href="javascript:void(0)" class="close-btn" id="CartcloseBtn">×</a>
                    </div>
                    <hr>
                    <div class="cart_product_container">
                        <div class="cart_product">
                            <div class="cart_image">
                                <img src="/images/dog sleeping on a dog, to advertise the dog bed with a plane grey background.jpg" alt="product image" />
                            </div>
                            <div class="cart_product_details">
                                <div class="name_header">
                                    <h3>Product Name</h3>
                                    <img src="/icons/dustbin.svg" alt="dustbin" height="20" />
                                </div>
                                <p>Price: ₹<span class="unit-price">2500</span></p>
                                <p>Color: Brown</p>
                                <div class="quantity_section">
                                    <input type="number" class="quantity" min="1" value="1" />
                                    <p>₹<span class="total-price">2500</span></p>
                                </div>
                            </div>
                        </div>
                        <!-- Add more cart products as needed -->
                    </div>
                    <div class="subtotal">
                        <hr>
                        <div class="subtotal_details">
                            <h3>Subtotal</h3>
                            <p>₹<span>2500</span></p>
                        </div>
                        <p class="cart_text">Taxes and shipping are calculated at checkout.</p>
                        <div class="checkout_button">
                            <button>Checkout</button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    </div>

    <div class="mobile_filter">
        <h2 class="filter_btn">Filters</h2>
    </div>

    <div class="breadcrumb">
        <a href="/home">Home</a>
        <span> > </span>
        <a href="/pet_accessory">Accessories</a>
    </div>

    <div class="main_container">
        <form class="filter_container">
            <h2 style="margin-bottom: 40px;">Filter by</h2>
            <div class="product_type filters">

                <div class="heading_button">
                    <h3>Product Type</h3>
                    <button class="expand-button">+</button>
                </div>

                <p class="hidden">
                    <input type="checkbox" id="pet_beds" name="product-type" value="Pet Beds">
                    <label for="pet_beds">Pet Beds</label>
                </p>


                <p class="hidden">
                    <input type="checkbox" id="pet_food" name="product-type" value="Pet Food">
                    <label for="pet_food">Pet Food</label>
                </p>

                <p class="hidden">
                    <input type="checkbox" id="grooming_supplies" name="product-type" value="Grooming Supplies">
                    <label for="grooming_supplies">Grooming Supplies</label>
                </p>
            </div>


            <hr>


            <div class="price filters">
                <div class="heading_button">
                    <h3>Price</h3>
                    <button class="expand-button">+</button>
                </div>
                
                
                <input type="range" id="price" class="hidden" name="price" min="0" max="5000" value="100" style="width: 100%;">
                
                <div class="price_labels hidden">
                    <span id="min-price">₹250.00</span>
                    <span id="max-price">₹5000.00</span>    
                </div>
                
            </div>


            <hr>


            <div class="color filters">
                <div class="heading_button">
                    <h3>Color</h3>
                    <button class="expand-button">+</button>
                </div>
                <p class="hidden">
                    <input type="checkbox" id="brown" name="color" value="Brown">
                    <label for="brown">Brown</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="grey" name="color" value="Grey">
                    <label for="grey">Grey</label>
                </p>
            </div>


            <hr>


            <div class="size filters">
                <div class="heading_button">
                    <h3>Size</h3>
                    <button class="expand-button">+</button>
                </div>
                <p class="hidden">
                    <input type="checkbox" id="small" name="size" value="small">
                    <label for="small">Small</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="medium" name="size" value="medium">
                    <label for="medium">Medium</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="large" name="size" value="large">
                    <label for="large">Large</label>
                </p>
            </div>


            <hr>


            <div class="weight filters">
                <div class="heading_button">
                    <h3>Weight</h3>
                    <button class="expand-button">+</button>
                </div>
                <p class="hidden">
                    <input type="checkbox" id="250gm" name="weight" value="250gm">
                    <label for="250gm">250gm</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="500gm" name="weight" value="500gm">
                    <label for="500gm">500gm</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="1kg" name="weight" value="1Kg">
                    <label for="1kg">1Kg</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="2kg" name="weight" value="2Kg">
                    <label for="2kg">2Kg</label>
                </p>
                <p class="hidden">
                    <input type="checkbox" id="5kg" name="weight" value="5Kg">
                    <label for="5kg">5Kg</label>
                </p>
            </div>
            <button type="submit">Apply Filter</button>
        </form>

        <div class="product_container">
            <% products.forEach(product => { %>
                <div class="product_card autoshow" data-product-id="<%= product.id %>">
                    <img src="<%= product.image_path || '/images/default-product.jpg' %>" alt="<%= product.product_name %>">
                    <div class="product_card_details">
                        <h3><%= product.product_name %></h3>
                        <p>
                            <% if (product.sale_price) { %>
                                ₹<%= product.sale_price %> <span style="text-decoration: line-through; color: #888;">₹<%= product.regular_price %></span>
                            <% } else { %>
                                ₹<%= product.regular_price %>
                            <% } %>
                        </p>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column">
                <h3>Happy Tails</h3>
                <ul>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/pet_accessory">Online Pet Accessories</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Partner</h3>
                <ul>
                    <li><a href="/store_signup">Pet Store Franchise</a></li>
                    <li><a href="/event_manager_signup">Become an Event manager</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Policy</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Refund Policy</a></li>
                    <li><a href="#">Cancellation Policy</a></li>
                    <li><a href="#">Terms & Conditions</a></li>
                </ul>
                <div class="footer-social">
                    <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="Facebook"></a>
                    <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="Instagram"></a>
                    <a href="#"><img src="/icons/youtube-icon-logo-svgrepo-com.svg" alt="YouTube"></a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Menu Toggle for Side Navbar
            const menuIcon = document.getElementById('menuIcon');
            const sideNavbar = document.getElementById('sideNavbar');
            const closeBtn = document.getElementById('closeBtn');

            menuIcon.addEventListener('click', function () {
                sideNavbar.classList.toggle('open');
            });

            closeBtn.addEventListener('click', function () {
                sideNavbar.classList.remove('open');
            });

            // Cart Toggle (Desktop and Mobile)
            const cart = document.getElementById('cart');
            const cartBtn = document.getElementById('cart_btn');
            const mobileCartBtn = document.getElementById('mobile_cart_btn');
            const cartCloseBtn = document.getElementById('CartcloseBtn');

            cartBtn.addEventListener('click', function () {
                cart.classList.toggle('open');
            });

            mobileCartBtn.addEventListener('click', function () {
                sideNavbar.classList.remove('open');
                cart.classList.toggle('open');
            });

            cartCloseBtn.addEventListener('click', function () {
                cart.classList.remove('open');
            });

            // Filter Expand/Collapse
            const expandButtons = document.querySelectorAll('.expand-button');
            expandButtons.forEach(button => {
                button.addEventListener('click', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const filterSection = this.closest('.filters');
                    const options = filterSection.querySelectorAll('p, .hidden');
                    options.forEach(option => option.classList.toggle('hidden'));
                    this.textContent = this.textContent === '+' ? '-' : '+';
                });
            });

            // Product Card Click Redirect
            document.querySelectorAll('.product_card').forEach(card => {
                card.addEventListener('click', function () {
                    const productId = this.getAttribute('data-product-id');
                    window.location.href = `/pet_product_details?id=${productId}`;
                });
            });

            // Mobile Filter Toggle
            const filterBtn = document.querySelector(".filter_btn");
            const filters = document.querySelector(".filter_container");
            const closeFiltersBtn = document.createElement("button");
            closeFiltersBtn.innerText = "✖ Close";
            closeFiltersBtn.classList.add("close-filters");
            filters.prepend(closeFiltersBtn);

            filterBtn.addEventListener("click", function () {
                filters.classList.add("show");
            });

            closeFiltersBtn.addEventListener("click", function () {
                filters.classList.remove("show");
            });

            // Cart Quantity and Price Calculation
            const cartProducts = document.querySelectorAll('.cart_product');
            cartProducts.forEach(product => {
                const quantityInput = product.querySelector('.quantity');
                const unitPriceElement = product.querySelector('.unit-price');
                const totalPriceElement = product.querySelector('.total-price');

                quantityInput.addEventListener("input", function () {
                    const unitPrice = parseFloat(unitPriceElement.textContent) || 0;
                    const quantity = parseInt(quantityInput.value) || 1;
                    const totalPrice = unitPrice * quantity;
                    totalPriceElement.textContent = totalPrice.toFixed(2);
                    updateSubtotal();
                });
            });

            function updateSubtotal() {
                let subtotal = 0;
                document.querySelectorAll('.total-price').forEach(total => {
                    subtotal += parseFloat(total.textContent) || 0;
                });
                document.querySelector('.subtotal span').textContent = subtotal.toFixed(2);
            }
            updateSubtotal();

            // Define products as a JavaScript variable
            

            // Filter Submission
            const filterForm = document.querySelector('.filter_container');
            const productCards = document.querySelectorAll('.product_card');

            filterForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(filterForm);
                const filters = {
                    productTypes: formData.getAll('product-type'),
                    minPrice: parseFloat(formData.get('min-price')) || 0,
                    maxPrice: parseFloat(formData.get('max-price')) || Infinity,
                    colors: formData.getAll('color'),
                    sizes: formData.getAll('size'),
                    weights: formData.getAll('weight')
                };

                productCards.forEach(card => {
                    const productId = card.getAttribute('data-product-id');
                    const product = productsData.find(p => p.id == productId);
                    const price = product.sale_price || product.regular_price;

                    const matchesType = filters.productTypes.length === 0 || (product.product_type && filters.productTypes.includes(product.product_type));
                    const matchesPrice = price >= filters.minPrice && price <= filters.maxPrice;
                    const matchesColor = filters.colors.length === 0 || (product.color && filters.colors.includes(product.color));
                    const matchesSize = filters.sizes.length === 0 || (product.size && filters.sizes.includes(product.size));
                    const matchesWeight = filters.weights.length === 0 || (product.weight && filters.weights.includes(product.weight.toString()));

                    card.style.display = (matchesType && matchesPrice && matchesColor && matchesSize && matchesWeight) ? 'block' : 'none';
                });
            });
        });
    </script>
</body>
</html>