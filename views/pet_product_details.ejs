<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
    <link rel="stylesheet" href="/pet accessory/pet_product_details.css">
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>

            <div class="menu">
                <a href="/pet_accessory">Pet Accessories</a>
                <a href="/pet_adoption">Shop</a>
                <a href="/services">Services</a>
                <a href="/Events">Events</a>
                <a href="/blog">Blog</a>
                <% if (user) { %>
                    <a href="/profile">Profile</a>
                <% } else { %>
                    <a href="/my_login">Login/SignUp</a>
                <% } %>
            </div>

            <div class="menu-icon" id="menuIcon">
                <img src="/icons/hamburger-svgrepo-com.svg" alt="Menu" height="25px" />
            </div>

            <div class="side-navbar" id="sideNavbar">
                <a href="javascript:void(0)" class="close-btn" id="closeBtn">&times;</a>
                <a href="/pet_adoption">Shop</a>
                <a href="/services">Services</a>        
                <a href="/Events">Events</a>
                <a href="/blog">Blog</a>
                <% if (user) { %>
                    <a href="/profile">Profile</a>
                <% } else { %>
                    <a href="/my_login">Login/SignUp</a>
                <% } %>
            </div>
        </header>
    </div>

    <div class="container">
        <div class="wrapper">
            <div class="mini_nav">
                <span> &lt; </span>
                <a href="/pet_accessory">Back</a>
            </div>
            <div class="product_container">
                <div class="image_container">
                    <img src="/images/dog sleeping on a dog, to advertise the dog bed with a plane grey background.jpg" alt="dog bed">
                </div>
        
                <div class="product_details">
                    <h1>Orthopedic Dog Bed</h1>
                    <p>₹2500</p>
                    <label for="size">Size</label>
                    <select name="size" id="size">
                        <option value="default">Select Size</option>
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                    </select>
                    <label for="quantity">Quantity</label>
                    <input type="number" id="quantity" value="1" min="1">
                    <button>Add to Cart</button>

                    <div>
                        <h4 style="font-weight: bold;">Share:</h4>
                    </div>
                    <div class="socials">
                        <a href="#"><img src="/icons/facebook-3-logo-svgrepo-com.svg" alt="Facebook"></a>
                        <a href="#"><img src="/icons/instagram-2016-logo-svgrepo-com.svg" alt="Instagram"></a>
                        <a href="#"><img src="/icons/twitter-svgrepo-com.svg" alt="Twitter"></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="footer-container">
    
            <div class="footer-column">
                <h3>Happy Tails</h3>
                <ul>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/pet_adoption">Pet Stores</a></li>
                    <li><a href="/pet_accessory">Online Pet Accessories</a></li>
                </ul>
            </div>
    
            <div class="footer-column">
                <h3>Services</h3>
                <ul>
                    <li><a href="/services">Pet Grooming</a></li>
                    <li><a href="/services">Dog Training</a></li>
                    <li><a href="/services">Vet Consultation</a></li>
                </ul>
            </div>
    
            <div class="footer-column">
                <h3>Partner</h3>
                <ul>
                    <li><a href="/service_signup">Become a Groomer</a></li>
                    <li><a href="/service_signup">Become a Dog Trainer</a></li>
                    <li><a href="/service_signup">Become Vet partner</a></li>
                    <li><a href="/store_signup">Pet Store Franchise</a></li>
                    <li><a href="/event_manager_signup">Become an Event manager</a></li>
                </ul>
            </div>
    
            <div class="footer-column">
                <h3>Policy</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Refund Policy</a></li>
                    <li><a href="#">Cancellation Policy</a></li>
                    <li><a href="#">Terms & Conditions</a></li>
                </ul>
                <div class="footer-social" >
                    <a href="#"><img
                            src="/icons/facebook-3-logo-svgrepo-com.svg"
                            alt="Facebook"></a>
                    <a href="#"><img
                            src="/icons/instagram-2016-logo-svgrepo-com.svg"
                            alt="Instagram"></a>
                    <a href="#"><img
                            src="/icons/youtube-icon-logo-svgrepo-com.svg"
                            alt="YouTube"></a>
                </div>
            </div>
        </div>
    </footer>

    <script>
         document.getElementById('menuIcon').addEventListener('click', function() {
                document.getElementById('sideNavbar').classList.toggle('open');
        });

        document.getElementById('closeBtn').addEventListener('click', function() {
                document.getElementById('sideNavbar').classList.remove('open');
        });
    </script>
</body>    