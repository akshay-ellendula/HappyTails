<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="services/service_analytics.css">
        <title>Vet Analytics - Happy Tails</title>
    </head>

    <body>
        <div class="navbar">
            <header>
                <a href="/home" class="badge">Happy Tails</a>
                <div class="menu">
                    <a href="/service_profile">Profile</a>
                    <a href="/home">Logout</a>
                </div>
            </header>
        </div>

        <div class="dashboard-container">
            <div class="sidebar">
                <h2>Dashboard</h2>
                <ul>
                    <li><a href="/service_dashbord">Home</a></li>
                    <li><a href="/service_history">Appointment
                            History</a></li>
                    <li><a href="/service_analytics">Analytics</a></li>
                </ul>
            </div>

            <div class="main-content">
                <div class="page-container active">
                    <div class="title-bar">
                        <h1 class="dashboard-title">Analytics</h1>
                    </div>

                    <div class="time-filter">
                        <button class="active" data-period="all">All
                            Time</button>
                        <button data-period="today">Today</button>
                        <button data-period="week">This Week</button>
                        <button data-period="month">This Month</button>
                        <button data-period="custom">Custom</button>
                    </div>

                    <h2 class="section-header">Revenue</h2>
                    <div class="analytics-grid">
                        <div class="card">
                            <h2>Revenue Overview</h2>
                            <div class="stat">
                                <div class="stat-label">Total Revenue</div>
                                <div class="stat-value">$24,850.00</div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">Today</div>
                                <div class="stat-value">$1,250.00 <span
                                        class="indicator up">+15%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Week</div>
                                <div class="stat-value">$5,320.00 <span
                                        class="indicator up">+8%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Month</div>
                                <div class="stat-value">$18,650.00 <span
                                        class="indicator up">+12%</span></div>
                            </div>
                        </div>

                        <div class="card">
                            <h2>Average Service Value</h2>
                            <div class="stat">
                                <div class="stat-label">Overall Average</div>
                                <div class="stat-value">$48.75</div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">Today</div>
                                <div class="stat-value">$52.10 <span
                                        class="indicator up">+7%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Week</div>
                                <div class="stat-value">$50.25 <span
                                        class="indicator up">+3%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Month</div>
                                <div class="stat-value">$49.50 <span
                                        class="indicator up">+1.5%</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Appointments Section -->
                    <h2 class="section-header">Appointments</h2>
                    <div class="analytics-grid">
                        <div class="card">
                            <h2>Appointment Overview</h2>
                            <div class="stat">
                                <div class="stat-label">Total Appointments</div>
                                <div class="stat-value">512</div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">Today</div>
                                <div class="stat-value">24 <span
                                        class="indicator up">+20%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Week</div>
                                <div class="stat-value">106 <span
                                        class="indicator up">+5%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">This Month</div>
                                <div class="stat-value">378 <span
                                        class="indicator up">+12%</span></div>
                            </div>
                        </div>

                        <div class="card">
                            <h2>Appointment Status</h2>
                            <div class="stat">
                                <div class="stat-label">Completed</div>
                                <div class="stat-value">428</div>
                            </div>
                            <div class="progress-bar">
                                <div class="progress" style="width: 84%;"></div>
                            </div>

                            <div class="stat">
                                <div class="stat-label">Pending</div>
                                <div class="stat-value">36</div>
                            </div>
                            <div class="progress-bar">
                                <div class="progress" style="width: 7%;"></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">Cancelled</div>
                                <div class="stat-value">48</div>
                            </div>
                            <div class="progress-bar">
                                <div class="progress"
                                    style="width: 9%; background-color: red;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Section -->
                    <h2 class="section-header">Customers</h2>
                    <div class="analytics-grid">
                        <div class="card">
                            <h2>Customer Overview</h2>
                            <div class="stat">
                                <div class="stat-label">Total Customers</div>
                                <div class="stat-value">346</div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">New Today</div>
                                <div class="stat-value">14 <span
                                        class="indicator up">+16%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">New This Week</div>
                                <div class="stat-value">48 <span
                                        class="indicator up">+10%</span></div>
                            </div>
                            <div class="stat">
                                <div class="stat-label">New This Month</div>
                                <div class="stat-value">125 <span
                                        class="indicator up">+22%</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>