<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="services/service_animaldetails.css">
    <title>Appointment Details</title>
</head>
<body>
    <div class="navbar">
        <header>
            <a href="home.html" class="badge">Happy Tails</a>
            <div class="menu">
                <a href="#">Profile</a>
                <a href="#">Logout</a>
            </div>
        </header>
    </div>
    <div class="dashboard-container">
        <div class="sidebar">
            <h2>Dashboard</h2>
            <ul>
                <li><a href="/service_dashbord">Home</a></li>
                <li><a href="/service_history">Appointment
                        History</a></li>
                <li><a href="/service_analytics">Analytics</a></li>
            </ul>
        </div>

        <div class="appointment-details">
            <h1>Appointment Details</h1>
            <p>2024-03-15 at 09:00 AM</p>
            <div class="details-container">
                <div class="details-section">
                    <h2>Appointment Information</h2>
                    <div class="info">
                        <p><strong>Date:</strong> 2024-03-15</p>
                        <p><strong>Time:</strong> 09:00 AM</p>
                        <p><strong>Location:</strong>Hyderbad</p>
                        <P><strong>House no:</strong>14-6-143/3/a</P>
                        <p><strong>stree no:</strong> 2</p>
                        <p><strong>Type:</strong> Checkup</p>
                        <p><strong>Reason for Visit:</strong> Annual health checkup and vaccination</p>
                    </div>
                </div>
                <div class="details-section">
                    <h2>Owner Information</h2>
                    <div class="info">
                        <p><strong>Name:</strong> John Doe</p>
                        <p><strong>Phone:</strong> +1 (555) 123-4567</p>
                        <p><strong>Email:</strong> john.doe@example.com</p>
                    </div>
                </div>
                <div class="details-section">
                    <h2>Pet Information</h2>
                    <div class="info">
                        <p><strong>Species:</strong> Dog</p>
                        <p><strong>Age:</strong> 5 years</p>
                        <p><strong>Weight:</strong> 30 kg</p>
                        <p><strong>Allergies:</strong> None</p>
                    </div>
                </div>
                <div class="details-section">
                    <h2>Medical History</h2>
                    <div class="history">
                        <p><strong>Vaccination</strong> 2023-09-15</p>
                        <p>Annual vaccines updated</p>
                        <p><strong>Checkup</strong> 2023-06-10</p>
                        <p>Routine health check - all normal</p>
                    </div>
                </div>
                <div class="details-section">
                    <h2>Charges</h2>
                    <div class="charges">
                        <label for="entry-charge"><strong>Entry Charge:</strong></label>
                        <input type="number" id="entry-charge" value="50" min="0" required>
                        <label for="other-charges"><strong>Other Charges:</strong></label>
                        <input type="number" id="other-charges" value="30" min="0" required>
                        <label for="total-amount"><strong>Total Amount:</strong></label>
                        <input type="number" id="total-amount" value="80" min="0" required readonly>
                        <label for="description"><strong>Description:</strong></label>
                        <textarea id="description" rows="4" placeholder="Enter description here..." required></textarea>
                    </div>
                </div>
            </div>
            <div class="actions-buttons">
                <button>Reschedule</button>
                <button class="cancle">Cancle appointment</button>
                <button class="primary">completed Consultation</button>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('entry-charge').addEventListener('input', updateTotal);
        document.getElementById('other-charges').addEventListener('input', updateTotal);
        
        function updateTotal() {
            const entryCharge = parseFloat(document.getElementById('entry-charge').value) || 0;
            const otherCharges = parseFloat(document.getElementById('other-charges').value) || 0;
            const totalAmount = entryCharge + otherCharges;
            document.getElementById('total-amount').value = totalAmount;
        }
    </script>
</body>
</html>