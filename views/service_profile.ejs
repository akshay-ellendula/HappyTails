<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Profile - Happy Tails</title>
        <link rel="stylesheet" href="/services/service_profile.css">
    </head>

    <body>
        <div class="navbar">
            <header>
                <a href="/home" class="badge">Happy Tails</a>
                <div class="menu">
                    <a href="/service_profile">Profile</a>
                    <a href="/home">Logout</a>
                </div>
            </header>
        </div>

        <div class="dashboard-container">
            <div class="sidebar">
                <h2>Dashboard</h2>
                <ul>
                    <li><a href="/service_dashbord">Home</a></li>
                    <li><a href="/service_history">Appointment
                            History</a></li>
                    <li><a href="/service_analytics">Analytics</a></li>
                </ul>
            </div>

            <div class="main-content">
                <div class="page-container active">
                    <div class="title-bar">
                        <h1 class="dashboard-title">Profile</h1>
                    </div>

                    <div class="profile-container">
                        <div class="profile-header">
                            <div class="profile-avatar">
                                <img src="/images/vet.jpg"
                                    alt="Profile Picture">
                                <div class="upload-overlay">
                                    <label for="upload-photo">
                                        <span class="upload-icon">+</span>
                                    </label>
                                    <input type="file" id="upload-photo"
                                        accept="image/*" style="display: none;">
                                </div>
                            </div>
                            <div class="profile-info">
                                <h2>Dr. John Smith</h2>
                                <p>Veterinarian</p>
                                <p>Member since: January 15, 2023</p>
                            </div>
                        </div>

                        <div class="profile-form">
                            <form id="profile-edit-form">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label for="first-name">First
                                            Name</label>
                                        <input type="text" id="first-name"
                                            name="first-name" value="John">
                                    </div>
                                    <div class="form-group">
                                        <label for="last-name">Last Name</label>
                                        <input type="text" id="last-name"
                                            name="last-name" value="Smith">
                                    </div>
                                    <div class="form-group">
                                        <label for="email">Email</label>
                                        <input type="email" id="email"
                                            name="email"
                                            value="john.smith@happytails.com" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="phone">Phone Number</label>
                                        <input type="tel" id="phone"
                                            name="phone" value="9391838479">
                                    </div>
                                    <div class="form-group">
                                        <label
                                            for="specialization">Specialization</label>
                                        <input type="text" id="specialization"
                                            name="specialization"
                                            value="Small Animal Medicine">
                                    </div>
                                    <div class="form-group">
                                        <label for="license">License
                                            Number</label>
                                        <input type="text" id="license"
                                            name="license" value="VET-12345-AB">
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label for="bio">Professional Bio</label>
                                    <textarea id="bio" name="bio"
                                        rows="4">Dr. John Smith is a dedicated veterinarian with over 10 years of experience in small animal medicine. He specializes in preventative care and has a particular interest in feline health.</textarea>
                                </div>

                                <div class="form-section">
                                    <h3>Change Password</h3>
                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label
                                                for="current-password">Current
                                                Password</label>
                                            <input type="password"
                                                id="current-password"
                                                name="current-password">
                                        </div>
                                        <div class="form-group">
                                            <label for="new-password">New
                                                Password</label>
                                            <input type="password"
                                                id="new-password"
                                                name="new-password">
                                        </div>
                                        <div class="form-group">
                                            <label
                                                for="confirm-password">Confirm
                                                New Password</label>
                                            <input type="password"
                                                id="confirm-password"
                                                name="confirm-password">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h3>Working Hours</h3>
                                    <div class="working-hours">
                                        <div class="day-row">
                                            <div class="day-name">Monday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="monday-start"
                                                    value="09:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="monday-end"
                                                    value="17:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="monday-off"
                                                        name="monday-off">
                                                    <label for="monday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div class="day-name">Tuesday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="tuesday-start"
                                                    value="09:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="tuesday-end"
                                                    value="17:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="tuesday-off"
                                                        name="tuesday-off">
                                                    <label for="tuesday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div
                                                class="day-name">Wednesday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="wednesday-start"
                                                    value="09:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="wednesday-end"
                                                    value="17:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="wednesday-off"
                                                        name="wednesday-off">
                                                    <label
                                                        for="wednesday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div class="day-name">Thursday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="thursday-start"
                                                    value="09:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="thursday-end"
                                                    value="17:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="thursday-off"
                                                        name="thursday-off">
                                                    <label
                                                        for="thursday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div class="day-name">Friday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="friday-start"
                                                    value="09:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="friday-end"
                                                    value="17:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="friday-off"
                                                        name="friday-off">
                                                    <label for="friday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div class="day-name">Saturday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="saturday-start"
                                                    value="10:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="saturday-end"
                                                    value="14:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="saturday-off"
                                                        name="saturday-off">
                                                    <label
                                                        for="saturday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="day-row">
                                            <div class="day-name">Sunday</div>
                                            <div class="hours-input">
                                                <input type="time"
                                                    name="sunday-start"
                                                    value="00:00">
                                                <span>to</span>
                                                <input type="time"
                                                    name="sunday-end"
                                                    value="00:00">
                                                <div class="day-off-toggle">
                                                    <input type="checkbox"
                                                        id="sunday-off"
                                                        name="sunday-off"
                                                        checked>
                                                    <label for="sunday-off">Day
                                                        Off</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="button"
                                        class="btn-secondary">Cancel</button>
                                    <button type="submit"
                                        class="btn-primary">Save
                                        Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('profile-edit-form');
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        clearErrors();
        let isValid = true;
        
        isValid = validatePersonalInfo() && isValid;
        isValid = validatePasswordChange() && isValid;
        isValid = validateWorkingHours() && isValid;
        
        if (isValid) {
            alert('Profile updated successfully!');
            // form.submit();
        }else{
            alert('Profile not updated successfully!');
        }
    });
    
    function validatePersonalInfo() {
        let isValid = true;
        
        const firstName = document.getElementById('first-name');
        if (!firstName.value.trim()) {
            showError(firstName, 'First name is required');
            isValid = false;
        } else if (!/^[A-Za-z\s]{2,}$/.test(firstName.value.trim())) {
            showError(firstName, 'First name should contain only letters and be at least 2 characters long');
            isValid = false;
        }
        
        const lastName = document.getElementById('last-name');
        if (!lastName.value.trim()) {
            showError(lastName, 'Last name is required');
            isValid = false;
        } else if (!/^[A-Za-z\s]{2,}$/.test(lastName.value.trim())) {
            showError(lastName, 'Last name should contain only letters and be at least 2 characters long');
            isValid = false;
        }
        const phone = document.getElementById('phone');
        if (!phone.value.trim()) {
            showError(phone, 'Phone number is required');
            isValid = false;
        } else if (!/^[0-9]{10,}$/.test(phone.value.trim())) {
            showError(phone, 'Please enter phone number in format: 1234567890');        
            isValid = false;
        }
        
        const license = document.getElementById('license');
        if (!license.value.trim()) {
            showError(license, 'License number is required');
            isValid = false;
        }
        
        return isValid;
    }
    
    function validatePasswordChange() {
        const currentPassword = document.getElementById('current-password');
        const newPassword = document.getElementById('new-password');
        const confirmPassword = document.getElementById('confirm-password');
        
        if (currentPassword.value || newPassword.value || confirmPassword.value) {
            if (!currentPassword.value) {
                showError(currentPassword, 'Current password is required');
                return false;
            }
            
            if (!newPassword.value) {
                showError(newPassword, 'New password is required');
                return false;
            }
            
            if (newPassword.value.length < 8) {
                showError(newPassword, 'Password must be at least 8 characters long');
                return false;
            }
            
            if (!confirmPassword.value) {
                showError(confirmPassword, 'Please confirm your new password');
                return false;
            }
            
            if (newPassword.value !== confirmPassword.value) {
                showError(confirmPassword, 'Passwords do not match');
                return false;
            }
        }
        
        return true;
    }
    
    function validateWorkingHours() {
        let isValid = true;
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        
        days.forEach(day => {
            const startTime = document.querySelector(`input[name="${day}-start"]`);
            const endTime = document.querySelector(`input[name="${day}-end"]`);
            const dayOff = document.getElementById(`${day}-off`);
            
            // Check if elements exist before proceeding
            if (!startTime || !endTime || !dayOff) {
                console.error(`Missing elements for ${day}`);
                return;
            }
            
            if (!dayOff.checked) {
                if (!startTime.value) {
                    showError(startTime, 'Start time is required');
                    isValid = false;
                }
                
                if (!endTime.value) {
                    showError(endTime, 'End time is required');
                    isValid = false;
                }
                
                // Convert times to comparable format
                if (startTime.value && endTime.value) {
                    const start = new Date(`2000-01-01T${startTime.value}`);
                    const end = new Date(`2000-01-01T${endTime.value}`);
                    
                    if (start >= end) {
                        showError(endTime, 'End time must be after start time');
                        isValid = false;
                    }
                }
            }
        });
        
        return isValid;
    }
    function showError(input, message) {
    let formGroup = input.closest('.form-group');
    if (!formGroup) {
        formGroup = input.parentElement;
        formGroup.classList.add('form-group');
    }
    
    const existingError = formGroup.querySelector('.error-message');
    if (existingError) {
        existingError.remove();
    }
    
    const error = document.createElement('div');
    error.className = 'error-message';
    error.textContent = message;
    formGroup.appendChild(error);
    formGroup.classList.add('error');
    
    // Add shake animation
    formGroup.classList.add('shake');
    setTimeout(() => {
        formGroup.classList.remove('shake');
    }, 500); // Remove after animation completes
}
    
    function clearErrors() {
        document.querySelectorAll('.error-message').forEach(error => error.remove());
        document.querySelectorAll('.form-group.error').forEach(group => group.classList.remove('error'));
    }
});
    </script>
    </body>
</html>