<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vendor Analytics - Happy Tails</title>
    <link href="/SHOP/shop-analytics.css" rel="stylesheet">
</head>
<body>
    <div class="header">
        <div class="logo">Happy Tails</div>
        <div class="user-info" id="profile-trigger">
            <span>Welcome, <%= vendor.store_name %></span>
            <div class="user-avatar"><%= vendor.store_name.charAt(0).toUpperCase() %></div>
        </div>
    </div>
    
    <!-- Profile Dropdown -->
    <div class="profile-dropdown" id="profile-dropdown">
        <div class="profile-header">
            <div class="profile-name"><%= vendor.store_name %></div>
            <div class="profile-email"><%= vendor.email || 'vendor@example.com' %></div>
        </div>
        <ul class="profile-menu">
            <li><a href="/shop-profile" id="profile-link">My Profile</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </div>
    
    <div class="container">
        <div class="sidebar">
            <ul class="sidebar-menu">
                <li><a href="/shop-dashboard/<%= vendor.store_name.toLowerCase().replace(/\s+/g, '-') %>" data-page="dashboard">Dashboard</a></li>
                <li><a href="/shop-products" data-page="products">Products</a></li>
                <li><a href="/shop-orders" data-page="orders">Orders</a></li>
                <li><a href="/shop-customers" data-page="customers">Customers</a></li>
                <li><a href="/shop-analytics" class="active" data-page="analytics">Analytics</a></li>
            </ul>
        </div>
        
        <div class="main-content" id="main-content">
            <!-- Analytics Content -->
            <div class="page-container active" id="analytics-page">
                <div class="title-bar">
                    <h1 class="dashboard-title">Analytics</h1>
                </div>
                
                <div class="time-filter">
                    <button class="<%= period === 'all' ? 'active' : '' %>" data-period="all" onclick="changePeriod('all')">All Time</button>
                    <button class="<%= period === 'today' ? 'active' : '' %>" data-period="today" onclick="changePeriod('today')">Today</button>
                    <button class="<%= period === 'week' ? 'active' : '' %>" data-period="week" onclick="changePeriod('week')">This Week</button>
                    <button class="<%= period === 'month' ? 'active' : '' %>" data-period="month" onclick="changePeriod('month')">This Month</button>
                </div>
                
                <!-- Revenue Section -->
                <h2 class="section-header">Revenue</h2>
                <div class="analytics-grid">
                    <div class="card">
                        <h2>Revenue Overview</h2>
                        <% if (period === 'all') { %>
    <div class="stat">
            <div class="stat-label">Total Revenue</div>
            <div class="stat-value">₹<%= analytics.revenue.total %></div>
        </div>

        <div class="stat">
            <div class="stat-label" style="color: #6c757d;">Platform Fees (6%)</div>
            <div class="stat-value" style="color: #dc3545;">- ₹<%= (parseFloat(analytics.revenue.total) / 0.94 * 0.06).toFixed(2) %></div>
        </div>
        <div class="stat">
            <div class="stat-label">Today</div>
            <div class="stat-value">₹<%= analytics.revenue.today %> <span class="indicator <%= analytics.revenue.todayChange >= 0 ? 'up' : 'down' %>"><%= analytics.revenue.todayChange >= 0 ? '+' : '' %><%= analytics.revenue.todayChange.toFixed(1) %>%</span></div>
        </div>
        <div class="stat">
            <div class="stat-label">This Week</div>
            <div class="stat-value">₹<%= analytics.revenue.week %> <span class="indicator <%= analytics.revenue.weekChange >= 0 ? 'up' : 'down' %>"><%= analytics.revenue.weekChange >= 0 ? '+' : '' %><%= analytics.revenue.weekChange.toFixed(1) %>%</span></div>
        </div>
        <div class="stat">
            <div class="stat-label">This Month</div>
            <div class="stat-value">₹<%= analytics.revenue.month %> <span class="indicator <%= analytics.revenue.monthChange >= 0 ? 'up' : 'down' %>"><%= analytics.revenue.monthChange >= 0 ? '+' : '' %><%= analytics.revenue.monthChange.toFixed(1) %>%</span></div>
        </div>
<% } else { %>
    <% 
        let revenueLabel = 'Revenue';
        let revenueValue = '0.00';
        let revenueChange = 0;
        if (period === 'today') {
            revenueLabel = 'Revenue Today';
            revenueValue = analytics.revenue.today;
            revenueChange = analytics.revenue.todayChange;
        } else if (period === 'week') {
            revenueLabel = 'Revenue This Week';
            revenueValue = analytics.revenue.week;
            revenueChange = analytics.revenue.weekChange;
        } else if (period === 'month') {
            revenueLabel = 'Revenue This Month';
            revenueValue = analytics.revenue.month;
            revenueChange = analytics.revenue.monthChange;
        }
    %>
    <div class="stat">
        <div class="stat-label"><%= revenueLabel %></div>
        <div class="stat-value">₹<%= revenueValue %> <span class="indicator <%= revenueChange >= 0 ? 'up' : 'down' %>"><%= revenueChange >= 0 ? '+' : '' %><%= revenueChange.toFixed(1) %>%</span></div>
    </div>
    <p style="font-size: 0.8rem; color: #666; margin-top: 15px;">Compared to the previous period.</p>
<% } %>
                    </div>
                    
                    <div class="card">
                        <h2>Revenue by Product Category</h2>
                        <% analytics.revenueByCategory.forEach((category, index) => { %>
                            <div class="stat">
                                <div class="stat-label"><%= category.category %></div>
                                <div class="stat-value">₹<%= category.revenue %></div>
                            </div>
                            <div class="progress-bar">
                                <div class="progress" data-progress="<%= category.percentage %>"></div>
                            </div>
                        <% }) %>
                        <% if (analytics.revenueByCategory.length === 0) { %>
                            <div class="stat">
                                <div class="stat-label">No Data</div>
                                <div class="stat-value">₹0.00</div>
                            </div>
                            <div class="progress-bar">
                                <div class="progress" data-progress="0"></div>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="card">
                        <h2>Average Order Value</h2>
                        <% if (period === 'all') { %>
    <div class="stat">
        <div class="stat-label">Overall Average</div>
        <div class="stat-value">₹<%= analytics.avgOrderValue.total %></div>
    </div>
    <div class="stat">
        <div class="stat-label">Today</div>
        <div class="stat-value">₹<%= analytics.avgOrderValue.today %> <span class="indicator <%= analytics.avgOrderValue.todayChange >= 0 ? 'up' : 'down' %>"><%= analytics.avgOrderValue.todayChange >= 0 ? '+' : '' %><%= analytics.avgOrderValue.todayChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">This Week</div>
        <div class="stat-value">₹<%= analytics.avgOrderValue.week %> <span class="indicator <%= analytics.avgOrderValue.weekChange >= 0 ? 'up' : 'down' %>"><%= analytics.avgOrderValue.weekChange >= 0 ? '+' : '' %><%= analytics.avgOrderValue.weekChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">This Month</div>
        <div class="stat-value">₹<%= analytics.avgOrderValue.month %> <span class="indicator <%= analytics.avgOrderValue.monthChange >= 0 ? 'up' : 'down' %>"><%= analytics.avgOrderValue.monthChange >= 0 ? '+' : '' %><%= analytics.avgOrderValue.monthChange.toFixed(1) %>%</span></div>
    </div>
<% } else { %>
    <% 
        let aovLabel = 'Average Order Value';
        let aovValue = '0.00';
        let aovChange = 0;
        if (period === 'today') {
            aovLabel = 'AOV Today';
            aovValue = analytics.avgOrderValue.today;
            aovChange = analytics.avgOrderValue.todayChange;
        } else if (period === 'week') {
            aovLabel = 'AOV This Week';
            aovValue = analytics.avgOrderValue.week;
            aovChange = analytics.avgOrderValue.weekChange;
        } else if (period === 'month') {
            aovLabel = 'AOV This Month';
            aovValue = analytics.avgOrderValue.month;
            aovChange = analytics.avgOrderValue.monthChange;
        }
    %>
    <div class="stat">
        <div class="stat-label"><%= aovLabel %></div>
        <div class="stat-value">₹<%= aovValue %> <span class="indicator <%= aovChange >= 0 ? 'up' : 'down' %>"><%= aovChange >= 0 ? '+' : '' %><%= aovChange.toFixed(1) %>%</span></div>
    </div>
    <p style="font-size: 0.8rem; color: #666; margin-top: 15px;">Compared to the previous period.</p>
<% } %>
                    </div>
                </div>
                
                <!-- Orders Section -->
                <h2 class="section-header">Orders</h2>
                <div class="analytics-grid">
                    <div class="card">
                        <h2>Order Overview</h2>
                        <% if (period === 'all') { %>
    <div class="stat">
        <div class="stat-label">Total Orders</div>
        <div class="stat-value"><%= analytics.orders.total %></div>
    </div>
    <div class="stat">
        <div class="stat-label">Today</div>
        <div class="stat-value"><%= analytics.orders.today %> <span class="indicator <%= analytics.orders.todayChange >= 0 ? 'up' : 'down' %>"><%= analytics.orders.todayChange >= 0 ? '+' : '' %><%= analytics.orders.todayChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">This Week</div>
        <div class="stat-value"><%= analytics.orders.week %> <span class="indicator <%= analytics.orders.weekChange >= 0 ? 'up' : 'down' %>"><%= analytics.orders.weekChange >= 0 ? '+' : '' %><%= analytics.orders.weekChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">This Month</div>
        <div class="stat-value"><%= analytics.orders.month %> <span class="indicator <%= analytics.orders.monthChange >= 0 ? 'up' : 'down' %>"><%= analytics.orders.monthChange >= 0 ? '+' : '' %><%= analytics.orders.monthChange.toFixed(1) %>%</span></div>
    </div>
<% } else { %>
    <% 
        let ordersLabel = 'Orders';
        let ordersValue = '0';
        let ordersChange = 0;
        if (period === 'today') {
            ordersLabel = 'Orders Today';
            ordersValue = analytics.orders.today;
            ordersChange = analytics.orders.todayChange;
        } else if (period === 'week') {
            ordersLabel = 'Orders This Week';
            ordersValue = analytics.orders.week;
            ordersChange = analytics.orders.weekChange;
        } else if (period === 'month') {
            ordersLabel = 'Orders This Month';
            ordersValue = analytics.orders.month;
            ordersChange = analytics.orders.monthChange;
        }
    %>
    <div class="stat">
        <div class="stat-label"><%= ordersLabel %></div>
        <div class="stat-value"><%= ordersValue %> <span class="indicator <%= ordersChange >= 0 ? 'up' : 'down' %>"><%= ordersChange >= 0 ? '+' : '' %><%= ordersChange.toFixed(1) %>%</span></div>
    </div>
    <p style="font-size: 0.8rem; color: #666; margin-top: 15px;">Compared to the previous period.</p>
<% } %>
                    </div>
                    
<div class="card">
    <h2>Order Status</h2>

    <div class="stat">
        <div class="stat-label">Confirmed</div>
        <div class="stat-value"><%= analytics.orders.status.confirmed %></div>
    </div>
    <div class="progress-bar">
        <div class="progress" style="background-color: #ffc107;" data-progress="<%= analytics.orders.total > 0 ? (analytics.orders.status.confirmed / analytics.orders.total * 100).toFixed(0) : 0 %>"></div>
    </div>

    <div class="stat">
        <div class="stat-label">Processing</div>
        <div class="stat-value"><%= analytics.orders.status.processing %></div>
    </div>
    <div class="progress-bar">
        <div class="progress" style="background-color: #17a2b8;" data-progress="<%= analytics.orders.total > 0 ? (analytics.orders.status.processing / analytics.orders.total * 100).toFixed(0) : 0 %>"></div>
    </div>

    <div class="stat">
        <div class="stat-label">Delivered</div>
        <div class="stat-value"><%= analytics.orders.status.delivered %></div>
    </div>
    <div class="progress-bar">
        <div class="progress" style="background-color: #28a745;" data-progress="<%= analytics.orders.total > 0 ? (analytics.orders.status.delivered / analytics.orders.total * 100).toFixed(0) : 0 %>"></div>
    </div>

    <div class="stat">
        <div class="stat-label">Cancelled</div>
        <div class="stat-value"><%= analytics.orders.status.cancelled %></div>
    </div>
    <div class="progress-bar">
        <div class="progress" style="background-color: #dc3545;" data-progress="<%= analytics.orders.total > 0 ? (analytics.orders.status.cancelled / analytics.orders.total * 100).toFixed(0) : 0 %>"></div>
    </div>
</div>
                </div>
                
                <!-- Customers Section -->
                <h2 class="section-header">Customers</h2>
                <div class="analytics-grid">
                    <div class="card">
                        <h2>Customer Overview</h2>
                        <% if (period === 'all') { %>
    <div class="stat">
        <div class="stat-label">Total Customers</div>
        <div class="stat-value"><%= analytics.customers.total %></div>
    </div>
    <div class="stat">
        <div class="stat-label">Customers Today</div>
        <div class="stat-value"><%= analytics.customers.today %> <span class="indicator <%= analytics.customers.todayChange >= 0 ? 'up' : 'down' %>"><%= analytics.customers.todayChange >= 0 ? '+' : '' %><%= analytics.customers.todayChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">Customers This Week</div>
        <div class="stat-value"><%= analytics.customers.week %> <span class="indicator <%= analytics.customers.weekChange >= 0 ? 'up' : 'down' %>"><%= analytics.customers.weekChange >= 0 ? '+' : '' %><%= analytics.customers.weekChange.toFixed(1) %>%</span></div>
    </div>
    <div class="stat">
        <div class="stat-label">Customers This Month</div>
        <div class="stat-value"><%= analytics.customers.month %> <span class="indicator <%= analytics.customers.monthChange >= 0 ? 'up' : 'down' %>"><%= analytics.customers.monthChange >= 0 ? '+' : '' %><%= analytics.customers.monthChange.toFixed(1) %>%</span></div>
    </div>
<% } else { %>
    <% 
        let customersLabel = 'Customers';
        let customersValue = '0';
        let customersChange = 0;
        if (period === 'today') {
            customersLabel = 'Customers Today';
            customersValue = analytics.customers.today;
            customersChange = analytics.customers.todayChange;
        } else if (period === 'week') {
            customersLabel = 'Customers This Week';
            customersValue = analytics.customers.week;
            customersChange = analytics.customers.weekChange;
        } else if (period === 'month') {
            customersLabel = 'Customers This Month';
            customersValue = analytics.customers.month;
            customersChange = analytics.customers.monthChange;
        }
    %>
    <div class="stat">
        <div class="stat-label"><%= customersLabel %></div>
        <div class="stat-value"><%= customersValue %> <span class="indicator <%= customersChange >= 0 ? 'up' : 'down' %>"><%= customersChange >= 0 ? '+' : '' %><%= customersChange.toFixed(1) %>%</span></div>
    </div>
    <p style="font-size: 0.8rem; color: #666; margin-top: 15px;">Compared to the previous period.</p>
<% } %>
                    </div>
                </div>
                
                <!-- Product Section -->
                <h2 class="section-header">Products</h2>
                <div class="analytics-grid">
                    <div class="card">
                        <h2>Product Overview</h2>
                        <div class="stat">
                            <div class="stat-label">Total Products</div>
                            <div class="stat-value"><%= analytics.products.total %></div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">Active Products</div>
                            <div class="stat-value"><%= analytics.products.active %></div>
                        </div>
                        <div class="stat">
                            <div class="stat-label">Out of Stock</div>
                            <div class="stat-value"><%= analytics.products.outOfStock %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Profile dropdown toggle
            const profileTrigger = document.getElementById('profile-trigger');
            const profileDropdown = document.getElementById('profile-dropdown');
            
            profileTrigger.addEventListener('click', function() {
                profileDropdown.classList.toggle('active');
            });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(event) {
                if (!profileTrigger.contains(event.target) && !profileDropdown.contains(event.target)) {
                    profileDropdown.classList.remove('active');
                }
            });

            // Period filter change handler
            window.changePeriod = function(period) {
                window.location.href = `/shop-analytics?period=${period}`;
            };

            // Set progress bar widths dynamically
            document.querySelectorAll('.progress').forEach(progress => {
                const percentage = progress.dataset.progress;
                if (percentage !== undefined) {
                    progress.style.width = `${percentage}%`;
                }
            });
        });
    </script>
</body>
</html>