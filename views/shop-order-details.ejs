<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Happy Tails</title>
    <link href="/SHOP/shop-order-details.css" rel="stylesheet">
</head>
<body>
    <div class="header">
        <button class="back-btn" onclick="goBack()">← Back to Orders</button>
        <h1>Order Details</h1>
    </div>
    
    <div class="order-container">
        <% if (order) { %>
            <div class="order-info">
                <h2 id="orderId">Order #<%= order.order_id %> <span id="orderStatus" class="order-status status-<%= order.status.toLowerCase() %>"><%= order.status %></span></h2>
                
                <div class="info-grid">
                    <div>
                        <div class="info-row">
                            <div class="info-label">Order Date:</div>
                            <div class="info-value" id="orderDate"><%= new Date(order.order_date).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Payment Method:</div>
                            <div class="info-value" id="paymentMethod"><%= order.payment_method %></div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Payment Status:</div>
                            <div class="info-value" id="paymentStatus"><%= order.payment_status %></div>
                        </div>
                    </div>
                    
                    <div>
                        <div class="info-row">
                            <div class="info-label">Customer:</div>
                            <div class="info-value" id="customerName"><%= order.customer.name %></div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Email:</div>
                            <div class="info-value" id="customerEmail"><%= order.customer.email %></div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Phone:</div>
                            <div class="info-value" id="customerPhone"><%= order.customer.phone %></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="order-info">
                <h3>Shipping Information</h3>
                
                <div class="info-grid">
                    <div>
                        <div class="info-row">
                            <div class="info-label">Shipping Address:</div>
                            <div class="info-value" id="shippingAddress"><%= order.shipping.address %></div>
                        </div>
                        
                        <div class="info-row">
                            <div class="info-label">Shipping Method:</div>
                            <div class="info-value" id="shippingMethod"><%= order.shipping.method %></div>
                        </div>
                    </div>
                    
                    <div>
                        <div class="info-row">
                            <div class="info-label">Estimated Delivery:</div>
                            <div class="info-value" id="estimatedDelivery"><%= order.shipping.estimated_delivery ? order.shipping.estimated_delivery.toDateString() : 'N/A' %></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="order-items">
                <h3>Order Items</h3>
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="orderItemsBody">
                        <% order.items.forEach(item => { %>
                            <tr>
                                <td><%= item.product_name %></td>
                                <td>₹<%= item.price.toFixed(2) %></td>
                                <td><%= item.quantity %></td>
                                <td>₹<%= (item.price * item.quantity).toFixed(2) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                
                <div class="order-summary">
                <div class="summary-row">
                    <div>Subtotal</div>
                    <div id="subtotal">₹<%= order.subtotal.toFixed(2) %></div>
                </div>
                <div class="summary-row">
                    <div>Platform Charges</div>
                    <div>₹<%= order.platform_charge.toFixed(2) %></div>
                </div>
                <div class="summary-total">
                    <div>Total</div>
                    <div id="total">₹<%= order.total.toFixed(2) %></div>
                </div>
            </div>
            </div>
            
            <div class="order-container">
                <div class="tracking-section">
                    <h3>Order Timeline</h3>
                    <div class="tracking-timeline">
                        <% order.timeline.forEach(event => { %>
                            <div class="timeline-item <%= event.status.toLowerCase() %>-item">
                                <div class="timeline-date"><%= new Date(event.date).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
                                <div class="timeline-content"><%= event.description %></div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <% if (order.status === 'Confirmed' || order.status === 'Shipped') { %>
<div class="order-actions">
    <h3>Update Order Status</h3>
    <p>Change the status of this order. The customer will be notified.</p>
    <div class="status-update-buttons">
        <% if (order.status === 'Confirmed') { %>
            <button class="action-btn shipped-btn" onclick="updateOrderStatus('<%= order.order_id %>', 'Shipped')">Mark as Shipped</button>
        <% } %>
        <% if (order.status === 'Confirmed' || order.status === 'Shipped') { %>
            <button class="action-btn delivered-btn" onclick="updateOrderStatus('<%= order.order_id %>', 'Delivered')">Mark as Delivered</button>
            <button class="action-btn cancelled-btn" onclick="updateOrderStatus('<%= order.order_id %>', 'Cancelled')">Cancel Order</button>
        <% } %>
    </div>
</div>
<% } %>
                
                <div class="action-buttons">
                    <button class="action-btn print-btn" onclick="printOrder()">Print Order</button>
                </div>
            </div>

            <!-- Delete Button for Pending Orders -->
            <button class="delete-btn" onclick="deleteOrder('<%= order.order_id %>')">Delete Order</button>                       

        <% } else { %>
            <div class="order-container">
                <p>No order details found.</p>
            </div>
        <% } %>
    </div>
    
    <script>
        function goBack() {
            window.location.href = '/shop-orders';
        }

        function printOrder() {
            window.print();
        }

        function deleteOrder(orderId) {
           if (confirm('Are you sure you want to delete this order?')) {
               fetch(`/delete-order/${orderId.replace('#ORD-', '')}`, {
                   method: 'DELETE',
                   headers: { 'Content-Type': 'application/json' }
               })
               .then(response => response.json())
               .then(data => {
                   if (data.success) {
                       alert('Order deleted successfully');
                       window.location.href = '/shop-orders';
                   } else {
                       alert('Error deleting order: ' + data.message);
                   }
               })
               .catch(error => {
                   console.error('Error:', error);
                   alert('Server error');
               });
           }
       }

       function updateOrderStatus(orderId, status) {
    const rawOrderId = orderId.replace('#ORD-', '');
    if (confirm(`Are you sure you want to change the order status to "${status}"?`)) {
        fetch(`/update-order-status/${rawOrderId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: status })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Order status updated successfully.');
                window.location.reload();
            } else {
                alert('Error updating status: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('A server error occurred.');
        });
    }
}

    </script>
</body>
</html>