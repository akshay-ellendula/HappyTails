<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Happy Tails</title>
    <link href="/SHOP/shop-order-details.css" rel="stylesheet">
</head>
<body>
    <div class="header">
        <button class="back-btn" onclick="goBack()">← Back to Orders</button>
        <h1>Order Details</h1>
    </div>
    
    <div class="order-container">
        <div class="order-info">
            <h2 id="orderId">Order #ORD-8945 <span id="orderStatus" class="order-status status-delivered">Delivered</span></h2>
            
            <div class="info-grid">
                <div>
                    <div class="info-row">
                        <div class="info-label">Order Date:</div>
                        <div class="info-value" id="orderDate">Mar 12, 2025</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Payment Method:</div>
                        <div class="info-value" id="paymentMethod">Credit Card (****4242)</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Payment Status:</div>
                        <div class="info-value" id="paymentStatus">Paid</div>
                    </div>
                </div>
                
                <div>
                    <div class="info-row">
                        <div class="info-label">Customer:</div>
                        <div class="info-value" id="customerName">Michael Brown</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Email:</div>
                        <div class="info-value" id="customerEmail">michael@example.com</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Phone:</div>
                        <div class="info-value" id="customerPhone">(123) 456-7890</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="order-info">
            <h3>Shipping Information</h3>
            
            <div class="info-grid">
                <div>
                    <div class="info-row">
                        <div class="info-label">Shipping Address:</div>
                        <div class="info-value" id="shippingAddress">123 Pet Street, Anytown, CA 12345</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Shipping Method:</div>
                        <div class="info-value" id="shippingMethod">Standard Shipping</div>
                    </div>
                </div>
                
                <div>
                    <div class="info-row">
                        <div class="info-label">Tracking Number:</div>
                        <div class="info-value" id="trackingNumber">TRK48392839283</div>
                    </div>
                    
                    <div class="info-row">
                        <div class="info-label">Estimated Delivery:</div>
                        <div class="info-value" id="estimatedDelivery">Mar 12, 2025</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="order-items">
            <h3>Order Items</h3>
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody id="orderItemsBody">
                    <tr>
                        <td>Premium Dog Collar</td>
                        <td>DC-001</td>
                        <td>$39.99</td>
                        <td>1</td>
                        <td>$39.99</td>
                    </tr>
                    <tr>
                        <td>Chew Toy</td>
                        <td>TY-003</td>
                        <td>$12.50</td>
                        <td>2</td>
                        <td>$25.00</td>
                    </tr>
                </tbody>
            </table>
            
            <div class="order-summary">
                <div class="summary-row">
                    <div>Subtotal</div>
                    <div id="subtotal">$64.99</div>
                </div>
                <div class="summary-row">
                    <div>Shipping</div>
                    <div id="shipping">$0.00</div>
                </div>
                <div class="summary-row">
                    <div>Tax</div>
                    <div id="tax">$0.00</div>
                </div>
                <div class="summary-total">
                    <div>Total</div>
                    <div id="total">$64.99</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="order-container">
        <div class="tracking-section">
            <h3>Order Timeline</h3>
            <div class="tracking-timeline">
                <div class="timeline-item delivered-item">
                    <div class="timeline-date">Mar 12, 2025 - 2:35 PM</div>
                    <div class="timeline-content">Order delivered</div>
                </div>
                <div class="timeline-item processing-item">
                    <div class="timeline-date">Mar 11, 2025 - 9:12 AM</div>
                    <div class="timeline-content">Order shipped via Standard Shipping</div>
                </div>
                <div class="timeline-item processing-item">
                    <div class="timeline-date">Mar 10, 2025 - 4:45 PM</div>
                    <div class="timeline-content">Order processed</div>
                </div>
                <div class="timeline-item pending-item">
                    <div class="timeline-date">Mar 10, 2025 - 11:20 AM</div>
                    <div class="timeline-content">Payment confirmed</div>
                </div>
                <div class="timeline-item pending-item">
                    <div class="timeline-date">Mar 10, 2025 - 11:15 AM</div>
                    <div class="timeline-content">Order placed</div>
                </div>
            </div>
        </div>
        
        <div class="action-buttons">
            <button class="action-btn print-btn" onclick="printOrder()">Print Order</button>
        </div>
    </div>
    
    <script>
        function goBack() {
            window.close(); 
        }
    </script>
</body>
</html>