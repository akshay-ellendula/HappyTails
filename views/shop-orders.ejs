                        <td>Premium Dog Collar, Chew Toy</td>
                        <td>$64.99</td>
                        <td>Mar 12, 2025</td>
                        <td><span class="status delivered">Delivered</span></td>
                        <td>
                            <i class="fa fa-eye"  data-page="shop-order-details"></i> 
                            <i class="fa fa-print"></i> 
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>#ORD-8944</td>
                        <td>Sarah Johnson</td>
                        <td>Cat Climbing Tree, Cat Food Bowl</td>
                        <td>$128.50</td>
                        <td>Mar 11, 2025</td>
                        <td><span class="status processing">Processing</span></td>
                        <td>
                            <i class="fa fa-eye" data-page="shop-order-details"></i>  
                            <i class="fa fa-print"></i>  
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>#ORD-8943</td>
                        <td>David Williams</td>
                        <td>Bird Cage, Bird Seed Mix</td>
                        <td>$87.25</td>
                        <td>Mar 11, 2025</td>
                        <td><span class="status delivered">Delivered</span></td>
                        <td>
                            <i class="fa fa-eye" data-page="shop-order-details"></i>  
                            <i class="fa fa-print"></i>  
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>#ORD-8942</td>
                        <td>Emily Davis</td>
                        <td>Fish Tank Filter, Aquarium Decorations</td>
                        <td>$105.99</td>
                        <td>Mar 10, 2025</td>
                        <td><span class="status pending">Pending</span></td>
                        <td>
                            <i class="fa fa-eye" data-page="shop-order-details"></i>  
                            <i class="fa fa-print"></i>  
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>#ORD-8941</td>
                        <td>James Wilson</td>
                        <td>Puppy Training Pads, Dog Shampoo</td>
                        <td>$42.75</td>
                        <td>Mar 10, 2025</td>
                        <td><span class="status delivered">Delivered</span></td>
                        <td>
                            <i class="fa fa-eye" data-page="shop-order-details"></i>  
                            <i class="fa fa-print"></i>  
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox"></td>
                        <td>#ORD-8940</td>
                        <td>Jennifer Taylor</td>
                        <td>Hamster Cage, Hamster Wheel</td>
                        <td>$68.25</td>
                        <td>Mar 9, 2025</td>
