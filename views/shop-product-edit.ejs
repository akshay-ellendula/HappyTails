<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - Happy Tails</title>
    <link href="/SHOP/shop-product-edit.css" rel="stylesheet">
</head>
<body>
    <div class="header">
        <button class="back-button" onclick="goBack()">
            ← Back
        </button>
        <h1 class="page-title">Edit Product</h1>
    </div>
    
    <div class="edit-container">
        <form id="editProductForm">
            <h2 class="section-title">Basic Information</h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="productName">Product Name</label>
                    <input type="text" id="productName" name="productName" required>
                </div>
                <div class="form-group">
                    <label for="productCategory">Category</label>
                    <select id="productCategory" name="productCategory" required>
                        <option value="">Select a category</option>
                        <option value="Dog Accessories">Dog Accessories</option>
                        <option value="Cat Accessories">Cat Accessories</option>
                        <option value="Bird Accessories">Bird Accessories</option>
                        <option value="Fish Accessories">Fish Accessories</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="productPrice">Price ($)</label>
                    <input type="number" id="productPrice" name="productPrice" step="0.01" min="0" required>
                </div>
                <div class="form-group">
                    <label for="productStock">Stock</label>
                    <input type="number" id="productStock" name="productStock" min="0" required>
                </div>
            </div>
            
            <h2 class="section-title">Photos</h2>
            <div class="photo-section">
                <div class="photo-row">
                    <div class="photo-box has-image" id="mainPhotoBox">
                        <img id="mainPhoto" src="./image.jpeg" alt="Product Photo">
                        <button type="button" class="remove-btn" onclick="removeImage('mainPhotoBox')">×</button>
                    </div>
                    <div class="photo-box" onclick="triggerFileInput('additionalPhoto1')">
                        <div class="photo-placeholder">+</div>
                        <div class="photo-text">Add Photo</div>
                        <input type="file" class="file-input" id="additionalPhoto1" accept="image/*" onchange="previewImage(this, 'additionalPhotoBox1')">
                    </div>
                    <div class="photo-box" onclick="triggerFileInput('additionalPhoto2')">
                        <div class="photo-placeholder">+</div>
                        <div class="photo-text">Add Photo</div>
                        <input type="file" class="file-input" id="additionalPhoto2" accept="image/*" onchange="previewImage(this, 'additionalPhotoBox2')">
                    </div>
                    <div class="photo-box" onclick="triggerFileInput('additionalPhoto3')">
                        <div class="photo-placeholder">+</div>
                        <div class="photo-text">Add Photo</div>
                        <input type="file" class="file-input" id="additionalPhoto3" accept="image/*" onchange="previewImage(this, 'additionalPhotoBox3')">
                    </div>
                </div>
            </div>
            
            <h2 class="section-title">Description</h2>
            <div class="form-group">
                <label for="shortDescription">Short Description</label>
                <input type="text" id="shortDescription" name="shortDescription" maxlength="100" required>
            </div>
            
            <div class="form-group">
                <label for="fullDescription">Full Description</label>
                <textarea id="fullDescription" name="fullDescription" required></textarea>
            </div>
            
            <h2 class="section-title">Additional Information</h2>
            <div class="form-row">
                <div class="form-group">
                    <label for="weight">Weight (g)</label>
                    <input type="number" id="weight" name="weight" min="0">
                </div>
                <div class="form-group">
                    <label for="dimensions">Dimensions (LxWxH cm)</label>
                    <input type="text" id="dimensions" name="dimensions" placeholder="e.g. 10x5x3">
                </div>
            </div>
            
            <div class="button-group">
                <button type="button" class="cancel-btn" onclick="goBack()">Cancel</button>
                <button type="submit" class="save-btn">Save Changes</button>
            </div>
        </form>
    </div>
    <script>

        // Function to go back to the previous page
function goBack() {
    window.location.href = "shop-products";
}

// Function to trigger file input click
function triggerFileInput(inputId) {
    document.getElementById(inputId).click();
}

// Function to preview uploaded image
function previewImage(input, boxId) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        
        reader.onload = function(e) {
            var box = input.parentElement;
            box.innerHTML = '';
            box.classList.add('has-image');
            
            var img = document.createElement('img');
            img.src = e.target.result;
            img.alt = "Product Photo";
            
            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'remove-btn';
            removeBtn.innerHTML = '×';
            removeBtn.onclick = function() {
                removeImage(box.id);
            };
            
            box.appendChild(img);
            box.appendChild(removeBtn);
            
            // Re-add the file input
            box.appendChild(input);
        }
        
        reader.readAsDataURL(input.files[0]);
    }
}

// Function to remove image
function removeImage(boxId) {
    var box = document.getElementById(boxId);
    box.innerHTML = '';
    box.classList.remove('has-image');
    
    var placeholder = document.createElement('div');
    placeholder.className = 'photo-placeholder';
    placeholder.innerHTML = '+';
    
    var text = document.createElement('div');
    text.className = 'photo-text';
    text.innerHTML = 'Add Photo';
    
    var input = document.createElement('input');
    input.type = 'file';
    input.className = 'file-input';
    input.id = boxId + 'Input';
    input.accept = 'image/*';
    input.onchange = function() {
        previewImage(this, boxId);
    };
    
    box.appendChild(placeholder);
    box.appendChild(text);
    box.appendChild(input);
    
    box.onclick = function() {
        triggerFileInput(boxId + 'Input');
    };
}


document.addEventListener('DOMContentLoaded', function() {
    // Get product ID from URL
    const urlParams = new URLSearchParams(window.location.search);
    const productId = urlParams.get('id');
    
    
    let productData;
    switch(productId) {
        case 'premium-dog-collar':
            productData = {
                name: 'Premium Dog Collar',
                category: 'Dog Accessories',
                price: 24.99,
                stock: 35,
                shortDescription: 'High-quality collar for dogs',
                fullDescription: 'Our premium dog collar is made from the finest materials, ensuring comfort and durability for your beloved pet. Available in various sizes to fit all breeds.',
                weight: 150,
                dimensions: '25x2x1'
            };
            break;
        case 'cat-climbing-tree':
            productData = {
                name: 'Cat Climbing Tree',
                category: 'Cat Accessories',
                price: 89.99,
                stock: 12,
                shortDescription: 'Multi-level cat tree for playful felines',
                fullDescription: 'Give your cat the perfect playground with our multi-level climbing tree. Features scratching posts, cozy hiding spots, and interactive toys.',
                weight: 5000,
                dimensions: '60x50x150'
            };
            break;
        case 'deluxe-bird-cage':
            productData = {
                name: 'Deluxe Bird Cage',
                category: 'Bird Accessories',
                price: 64.50,
                stock: 8,
                shortDescription: 'Spacious cage for small to medium birds',
                fullDescription: 'Our deluxe bird cage provides ample space for your feathered friends to fly and play. Includes perches, feeding stations, and easy-clean design.',
                weight: 3000,
                dimensions: '40x35x70'
            };
            break;
        case 'aquarium-filter-system':
            productData = {
                name: 'Aquarium Filter System',
                category: 'Fish Accessories',
                price: 45.75,
                stock: 22,
                shortDescription: 'Advanced filtration for fresh and saltwater tanks',
                fullDescription: 'Keep your aquarium crystal clear with our advanced filter system. Compatible with both fresh and saltwater tanks, providing biological, mechanical, and chemical filtration.',
                weight: 800,
                dimensions: '20x15x25'
            };
            break;
        default:
            productData = {
                name: '',
                category: '',
                price: 0,
                stock: 0,
                shortDescription: '',
                fullDescription: '',
                weight: 0,
                dimensions: ''
            };
    }
    
    // Populate form with product data
    document.getElementById('productName').value = productData.name;
    document.getElementById('productCategory').value = productData.category;
    document.getElementById('productPrice').value = productData.price;
    document.getElementById('productStock').value = productData.stock;
    document.getElementById('shortDescription').value = productData.shortDescription;
    document.getElementById('fullDescription').value = productData.fullDescription;
    document.getElementById('weight').value = productData.weight;
    document.getElementById('dimensions').value = productData.dimensions;
    
    // Handle form submission
    document.getElementById('editProductForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Gather form data
        const formData = {
            name: document.getElementById('productName').value,
            category: document.getElementById('productCategory').value,
            price: parseFloat(document.getElementById('productPrice').value),
            stock: parseInt(document.getElementById('productStock').value),
            shortDescription: document.getElementById('shortDescription').value,
            fullDescription: document.getElementById('fullDescription').value,
            weight: document.getElementById('weight').value,
            dimensions: document.getElementById('dimensions').value
        };
        
        // In a real app, you would send this data to your server
        console.log('Product data to save:', formData);
        
        // Show success message
        alert('Product updated successfully!');
        
        // Redirect back to products page
        goBack();
    });
});
    </script>
</body>
</html>