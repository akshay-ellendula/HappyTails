<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Tails - Vendor Profile</title>
    <link href="/SHOP/shop-profile.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <!-- Main Content -->
        <div class="main-content">
            <div class="header">
                <h1>Profile</h1>
                <button class="btn back-btn" onclick="goBack()">← Back</button>
            </div>

            <!-- Stats Cards -->
            <div class="stats-container">
                <div class="stat-card">
                    <h3>TOTAL REVENUE</h3>
                    <div class="value">$4,385.00</div>
                    <div class="trend">+12.5% from last month</div>
                </div>
                <div class="stat-card">
                    <h3>PRODUCTS SOLD</h3>
                    <div class="value">78</div>
                    <div class="trend">+5.2% from last month</div>
                </div>
                <div class="stat-card">
                    <h3>NEW ORDERS</h3>
                    <div class="value">14</div>
                    <div class="status">Awaiting processing</div>
                </div>
                <div class="stat-card">
                    <h3>CUSTOMER RATINGS</h3>
                    <div class="value">4.8/5</div>
                    <div class="trend">+0.3 from last month</div>
                </div>
            </div>

            <!-- Profile Content -->
            <div class="content-card">
                <div class="card-header">
                    <h2>Vendor Profile</h2>
                </div>
                
                <!-- View Profile -->
                <div id="profile-view" class="profile-section">
                    <div class="profile-field">
                        <label>Store Name</label>
                        <p>Happy Tails Pet Shop</p>
                    </div>
                    <div class="profile-field">
                        <label>Store Owner</label>
                        <p>Alex Johnson</p>
                    </div>
                    <div class="profile-field">
                        <label>Email</label>
                        <p>alex@happytails.com</p>
                    </div>
                    <div class="profile-field">
                        <label>Phone</label>
                        <p>(555) 123-4567</p>
                    </div>
                    <div class="profile-field">
                        <label>Address</label>
                        <p>123 Pet Lane, Furryville, CA 94123</p>
                    </div>
                    <div class="profile-field">
                        <label>Store Description</label>
                        <p>Happy Tails specializes in high-quality, eco-friendly pet accessories for cats and dogs. All our products are designed with pet comfort and safety in mind, using sustainable materials whenever possible.</p>
                    </div>
                    <div class="button-container">
                        <button id="edit-btn" class="btn btn-dark">Edit Profile</button>
                    </div>
                </div>
                
                <!-- Edit Profile -->
                <div id="profile-edit" class="profile-section hidden">
                    <div class="profile-field">
                        <label for="store-name">Store Name</label>
                        <input type="text" id="store-name" value="Happy Tails Pet Shop">
                    </div>
                    <div class="profile-field">
                        <label for="owner-name">Store Owner</label>
                        <input type="text" id="owner-name" value="Alex Johnson">
                    </div>
                    <div class="profile-field">
                        <label for="email">Email</label>
                        <input type="email" id="email" value="alex@happytails.com">
                    </div>
                    <div class="profile-field">
                        <label for="phone">Phone</label>
                        <input type="tel" id="phone" value="(555) 123-4567">
                    </div>
                    <div class="profile-field">
                        <label for="address">Address</label>
                        <input type="text" id="address" value="123 Pet Lane, Furryville, CA 94123">
                    </div>
                    <div class="profile-field">
                        <label for="description">Store Description</label>
                        <textarea id="description">Happy Tails specializes in high-quality, eco-friendly pet accessories for cats and dogs. All our products are designed with pet comfort and safety in mind, using sustainable materials whenever possible.</textarea>
                    </div>
                    <div class="button-container">
                        <button id="cancel-btn" class="btn btn-dark">Cancel</button>
                        <button id="save-btn" class="btn btn-dark">Save Changes</button>
                    </div>
                </div>
            </div>

            <!-- Recent Orders -->
            <div class="content-card">
                <div class="card-header">
                    <h2>Recent Orders</h2>
                    <a href="/shop-orders" class="view-all">View All</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#ORD-7829</td>
                            <td>Emma Johnson</td>
                            <td>Cozy Cat Cave</td>
                            <td>Mar 12, 2025</td>
                            <td>$59.99</td>
                            <td><span class="status-badge completed">Completed</span></td>
                        </tr>
                        <tr>
                            <td>#ORD-7830</td>
                            <td>Michael Brown</td>
                            <td>Dog Bed (Medium)</td>
                            <td>Mar 12, 2025</td>
                            <td>$89.99</td>
                            <td><span class="status-badge pending">Pending</span></td>
                        </tr>
                        <tr>
                            <td>#ORD-7831</td>
                            <td>Sophia Wilson</td>
                            <td>Pet Nail Clippers</td>
                            <td>Mar 11, 2025</td>
                            <td>$24.99</td>
                            <td><span class="status-badge completed">Completed</span></td>
                        </tr>
                        <tr>
                            <td>#ORD-7832</td>
                            <td>David Garcia</td>
                            <td>Cozy Cat Cave</td>
                            <td>Mar 11, 2025</td>
                            <td>$59.99</td>
                            <td><span class="status-badge pending">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="button-container">
                <button class="btn btn-dark" onclick="window.location.href='shop-products'">Add New Product</button>
                <button class="btn btn-dark" onclick="window.location.href='shop-analytics'">View Sales Report</button>
            </div>
        </div>
    </div>

    <script src="/SHOP/shop-profile.js">

    function goBack() {
    window.history.back();
}
    </script>
  </body>
  </html>
            