<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/login/store_signup.css">
    <title>store signup</title>
</head>
<body>
    <div class="navbar">
        <header>
            <a href="/home" class="badge">Happy Tails</a>
            <a href="Account"></a>
        </header>
    </div>
    <div class="container">
        <form action="#">
        <h1>Sign Up To Become Happy Tails Store Partner</h1>
        <p>Please fill this form to create an account</p>
        <label for="name">Name</label>
        <input type="text" placeholder="Enter Name" name="name" required>
        <label for="contactnumber">Contact Number</label>
        <input type="text" placeholder="Enter Contact Number" name="contactnumber" required>
        <label for="email">Email</label>
        <input type="text" placeholder="Enter Email" name="email" required>
        <label for="password">Password</label>
        <input type="password" placeholder="Enter Password" name="password" required>
        <label for="confirmpassword">Confirm Password</label>
        <input type="password" placeholder="Confirm Password" name="confirmpassword" required>
        <label for="storename">Store Name</label>
        <input type="text" placeholder="Enter Store Name" name="storename" required>
        <label for="storelocation">Store Location</label>
        <input type="text" placeholder="Enter Store Location" name="storelocation" required>
        <div class="terms">
        <input type="checkbox" name="termsandconditions" id="tac">
        <label for="termsandconditions">I have Read all your <a href="">Terms & Conditions</a>.I wish to Register </label>
        </div>
        <button type="submit" class="registerbtn">Register</button>
        </form>
    </div>
    <footer class="footer">
        <div class="footer-container">

            <div class="footer-column">
                <h3>Happy Tails</h3>
                <ul>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/pet_adoption">Pet Stores</a></li>
                    <li><a href="/pet_accessory">Online Pet Accessories</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Services</h3>
                <ul>
                    <li><a href="/services">Pet Grooming</a></li>
                    <li><a href="/services">Dog Training</a></li>
                    <li><a href="/services">Vet Consultation</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Partner</h3>
                <ul>
                    <li><a href="/service_login">Become a Groomer</a></li>
                    <li><a href="/service_login">Become a Dog Trainer</a></li>
                    <li><a href="/service_login">Become Vet partner</a></li>
                    <li><a href="#">Pet Store Franchise</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Policy</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Refund Policy</a></li>
                    <li><a href="#">Cancellation Policy</a></li>
                    <li><a href="#">Terms & Conditions</a></li>
                </ul>
                <div class="footer-social">
                    <a href="#"><img
                            src="/icons/facebook-3-logo-svgrepo-com.svg"
                            alt="Facebook"></a>
                    <a href="#"><img
                            src="/icons/instagram-2016-logo-svgrepo-com.svg"
                            alt="Instagram"></a>
                    <a href="#"><img
                            src="/icons/youtube-icon-logo-svgrepo-com.svg"
                            alt="YouTube"></a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>